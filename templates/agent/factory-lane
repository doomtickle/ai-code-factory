#!/usr/bin/env bash
set -euo pipefail

# Usage: factory-lane repos   <project>
#        factory-lane prepare <project> <lane> [<name> <email>]
#        factory-lane export  <project> <lane> <rel> [full]
#        factory-lane bundle  <project> <lane> <rel> <branch> [<base>]
#        factory-lane review  <project> <ref> [<rel>]
#
# Private git clones ("lanes") of the read-only project, on this sandbox's own
# disk. A writable role works in its lane and commits to factory/* branches;
# the dispatch bridge brings those back to the host as git bundles.
#
# <project> is the project's absolute path (FACTORY_PROJECT), mounted read-only.
# It is one repo (it has a .git) or a folder of repos (its immediate, not
# hidden, not symlinked subdirectories that have a .git). A repo's <rel> is "."
# or that subdirectory's name.
#
#   repos    Print the project's repos (<rel>), one per line.
#   prepare  Clone each repo into the lane (or fetch origin if it is already
#            cloned). The last line of stdout is the lane dir:
#            ${FACTORY_LANES_ROOT:-$HOME/lanes}/<lane> (repo "."), with the
#            repos of a folder of repos as its subdirectories. Each lane repo
#            gets a repo-local git identity (user.name, user.email): <name> and
#            <email> if given and not empty, else factory-<lane> and
#            <lane>@factory.invalid. "{lane}" in either is replaced by <lane>.
#            Submodules (top level only) that the project's repo has itself
#            initialised are initialised in the lane too, at the superproject's
#            pin, from the project's own module store (read-only, no network);
#            ones it has not are left empty, with a note on stderr. A lane
#            sets submodule.recurse so its submodules follow branch switches.
#   export   Write to stdout a git bundle of the lane repo's factory/* branches,
#            without the commits the project's repo already has (its ref tips,
#            read from the project itself, not from the lane's origin/* refs,
#            which the role may have moved). With "full", the branches' whole
#            history, for when the project lacks a prerequisite anyway. Exit 3
#            when there is nothing to export.
#   bundle   For the broker's git_push: write <base>..<branch> from the lane
#            repo to <project>/.factory/outgoing/<name>.bundle and print
#            <name>.bundle, the file name git_push takes. <branch> must be a
#            factory/* branch; <base> is a branch name on origin (default:
#            origin/HEAD, the branch the project has checked out).
#   review   For read-only roles: clone <project>/<rel> (default ".") into
#            $HOME/review/, check out <ref> (e.g.
#            factory-developer/factory/x, or refs/remotes/factory-developer/factory/x)
#            as branch "review", discarding local edits there, and print the
#            checkout's path as the last line of stdout. origin is the project,
#            so `git diff origin/main...HEAD` shows the change. Submodules are
#            initialised as in prepare.
#
# <lane> must match ^[a-z][a-z0-9-]{1,40}$.
#
# Baked into the developer and reviewer images (templates/*/Dockerfile).

USAGE="usage: factory-lane repos <project> | prepare <project> <lane> [<name> <email>] | export <project> <lane> <rel> [full] | bundle <project> <lane> <rel> <branch> [<base>] | review <project> <ref> [<rel>]"

die() { echo "factory-lane: $*" >&2; exit 1; }
say() { echo "factory-lane: $*" >&2; }

# Byte-order globbing and sorting, as the host side (common.sh, server.py) sorts.
export LC_ALL=C
export GIT_TERMINAL_PROMPT=0

# The read-only source may be owned by another uid (e.g. macOS uid 501).
g() { git -c safe.directory='*' -c core.fsmonitor=false "$@"; }

# project_repos PROJECT: see the header.
project_repos() {
  local p="$1" d name
  if [ -e "$p/.git" ]; then
    echo .
    return 0
  fi
  for d in "$p"/*; do
    name="${d##*/}"
    case "$name" in .*|*$'\n'*) continue ;; esac
    [ ! -L "$d" ] && [ -d "$d" ] || continue
    [ -d "$d/.git" ] || [ -f "$d/.git" ] || continue
    printf '%s\n' "$name"
  done
}

check_project() {
  case "$1" in /*) ;; *) die "project must be an absolute path: $1" ;; esac
  [ -d "$1" ] || die "no such project directory: $1"
}

check_lane() {
  [[ "$1" =~ ^[a-z][a-z0-9-]{1,40}$ ]] || die "invalid lane name: $1"
}

check_rel() { # check_rel PROJECT REL
  local r
  while IFS= read -r r; do
    [ "$r" != "$2" ] || return 0
  done < <(project_repos "$1")
  die "not a repo of $1: $2"
}

# check_identity NAME EMAIL: refuse what git or a reader could misread: a
# control character (newline included), "<" or ">" (git's ident delimiters),
# a leading "-" (an option to git config), whitespace in the email, or an
# email without exactly one "@" between non-empty parts.
check_identity() {
  local name="$1" email="$2" bad='[[:cntrl:]<>]'
  local email_re='^[^-@[:space:][:cntrl:]<>][^@[:space:][:cntrl:]<>]*@[^@[:space:][:cntrl:]<>]+$'
  [ -n "${name//[[:space:]]/}" ] && [ "${#name}" -le 128 ] && ! [[ "$name" =~ $bad ]] \
    && [ "${name#-}" = "$name" ] || die "invalid git author name: ${name//[[:cntrl:]]/?}"
  [ "${#email}" -le 254 ] && [[ "$email" =~ $email_re ]] \
    || die "invalid git author email: ${email//[[:cntrl:]]/?}"
}

# set_identity REPO NAME EMAIL: the lane's commits are authored as NAME <EMAIL>.
set_identity() {
  g -C "$1" config user.name "$2" && g -C "$1" config user.email "$3" \
    || die "can't set the git identity in $1"
}

lanes_root() {
  local root="${FACTORY_LANES_ROOT:-$HOME/lanes}"
  case "$root" in /*) ;; *) die "FACTORY_LANES_ROOT must be absolute: $root" ;; esac
  printf '%s\n' "$root"
}

# set_origin REPO URL: (re)point origin at URL, re-adding it if it was removed.
set_origin() {
  g -C "$1" remote set-url origin "$2" 2>/dev/null || g -C "$1" remote add origin "$2" >&2 \
    || die "can't set origin in $1"
}

# source_of PROJECT REL: the repo's path in the project.
source_of() { if [ "$2" = . ]; then printf '%s\n' "$1"; else printf '%s\n' "$1/$2"; fi; }

# target LANE_DIR REL: where repo REL lives in the lane.
target() { if [ "$2" = . ]; then printf '%s\n' "$1"; else printf '%s\n' "$1/$2"; fi; }

# init_submodules SRC REPO: initialise REPO's top-level submodules that the
# project's repo SRC has initialised, from SRC's own module store (objects only;
# nothing from a workspace is executed), at the pin REPO's HEAD records. Every
# ref of the store is fetched into the lane's submodule and submodule.recurse is
# set, so a checkout or switch to a branch with another pin moves the submodule
# too (else "git add -A" would commit the old pin over the new one). The
# name and path come from the lane's .gitmodules, which the role can edit, so
# ones that could leave the module store or the clone are skipped. A submodule
# SRC has not initialised is left empty with a note; git failing on one that
# SRC has is fatal.
init_submodules() {
  local src="$1" repo="$2" key sname spath mdir lmod
  [ -f "$repo/.gitmodules" ] || return 0
  while IFS= read -r -d '' key; do
    sname="${key%%$'\n'*}"
    spath="${key#*$'\n'}"
    sname="${sname#submodule.}"
    sname="${sname%.path}"
    case "/$sname/$spath/" in
      *//*|*/../*|*/./*|*/.git/*|*[[:cntrl:]]*)
        say "skipping submodule with an unsafe name or path: ${sname//[[:cntrl:]]/?}"
        continue ;;
    esac
    mdir="$(g -C "$src" rev-parse --git-path "modules/$sname" 2>/dev/null)" || mdir=""
    case "$mdir" in "") ;; /*) ;; *) mdir="$src/$mdir" ;; esac
    if [ -z "$mdir" ] || [ ! -f "$mdir/HEAD" ]; then
      say "submodule $spath is not initialised in $src; leaving it empty in $repo"
      continue
    fi
    # An existing lane's submodule fetches from its own origin, not from submodule.<name>.url.
    # git hands these "-c" settings on to the clone and checkout it spawns.
    lmod="$(g -C "$repo" rev-parse --git-path "modules/$sname")"
    case "$lmod" in /*) ;; *) lmod="$repo/$lmod" ;; esac
    { g -C "$repo" config "submodule.$sname.url" "$mdir" \
      && { [ ! -f "$lmod/config" ] || g config -f "$lmod/config" remote.origin.url "$mdir"; } \
      && g -c core.hooksPath=/dev/null -c protocol.file.allow=always -C "$repo" \
        submodule update --quiet --init --checkout -- "$spath" >&2 \
      && g -c core.hooksPath=/dev/null -c protocol.file.allow=always --git-dir="$lmod" \
        fetch --quiet --no-tags "$mdir" '+refs/*:refs/factory-host/*' '+HEAD:refs/factory-host/HEAD' >&2 \
      && g -C "$repo" config submodule.recurse true; } \
      || die "can't initialise submodule $spath in $repo from $mdir"
  done < <(g config -f "$repo/.gitmodules" --null --get-regexp '^submodule\..*\.path$' 2>/dev/null || true)
}

cmd_repos() {
  [ $# -eq 1 ] || die "$USAGE"
  check_project "$1"
  project_repos "$1"
}

cmd_prepare() {
  [ $# -eq 2 ] || [ $# -eq 4 ] || die "$USAGE"
  local project="$1" lane="$2" name="${3:-}" email="${4:-}" root lanedir rel t s found=""
  check_project "$project"
  check_lane "$lane"
  [ -n "$name" ] || name="factory-{lane}"
  [ -n "$email" ] || email="{lane}@factory.invalid"
  name="${name//"{lane}"/"$lane"}"
  email="${email//"{lane}"/"$lane"}"
  check_identity "$name" "$email"
  root="$(lanes_root)"
  lanedir="$root/$lane"
  mkdir -p "$root"
  while IFS= read -r rel; do
    found=1
    t="$(target "$lanedir" "$rel")"
    s="$(source_of "$project" "$rel")"
    if [ -e "$t/.git" ]; then
      say "fetching $s into $t"
      # The lane is the role's to change; point origin back at the project.
      set_origin "$t" "$s"
      g -C "$t" fetch --quiet --prune --no-recurse-submodules origin >&2 || die "fetch failed in $t"
      # origin/HEAD follows the branch checked out in the project, so new work
      # starts from where the user is now. A detached project HEAD keeps the old one.
      g -C "$t" remote set-head origin --auto >/dev/null 2>&1 || true
    else
      say "cloning $s into $t"
      [ "$rel" = . ] || mkdir -p "$lanedir"
      g clone --quiet --no-hardlinks -- "$s" "$t" >&2 || die "clone of $s failed"
    fi
    set_identity "$t" "$name" "$email"
    init_submodules "$s" "$t"
  done < <(project_repos "$project")
  [ -n "$found" ] || die "no git repos in $project (it has no .git, nor subdirectories with one)"
  (cd "$lanedir" && pwd -P)
}

# project_has SRC REPO: the ref tips of the project's repo SRC that the lane
# repo REPO has, as rev-list exclusions ("^<sha>", one per line). What the
# project already has is read from the project itself, never from the lane's
# origin/* refs: the role can move those (importing a git_fetch bundle into
# origin/main does), and a bundle whose prerequisites the project lacks can't
# be imported there.
project_has() {
  g -C "$1" for-each-ref --format='%(objectname)' refs/heads refs/remotes refs/tags 2>/dev/null \
    | LC_ALL=C sort -u \
    | g -C "$2" cat-file --batch-check='%(objectname) %(objecttype)' 2>/dev/null \
    | awk '$2 == "commit" || $2 == "tag" { print "^" $1 }'
}

cmd_export() {
  [ $# -eq 3 ] || { [ $# -eq 4 ] && [ "$4" = full ]; } || die "$USAGE"
  local project="$1" lane="$2" rel="$3" mode="${4:-}" repo rc x
  local -a not=()
  check_project "$project"
  check_lane "$lane"
  check_rel "$project" "$rel"
  repo="$(target "$(lanes_root)/$lane" "$rel")"
  if [ ! -e "$repo/.git" ]; then
    say "nothing to export: no lane clone at $repo"
    exit 3
  fi
  if [ -z "$(g -C "$repo" for-each-ref --count=1 --format='%(refname)' refs/heads/factory/)" ]; then
    say "nothing to export: no factory/* branches in $repo"
    exit 3
  fi
  if [ "$mode" != full ]; then
    while IFS= read -r x; do not+=("$x"); done < <(project_has "$(source_of "$project" "$rel")" "$repo")
  fi
  if [ -z "$(g -C "$repo" rev-list -n 1 '--branches=factory/*' ${not[@]+"${not[@]}"})" ]; then
    say "nothing to export: the project already has every factory/* commit in $repo"
    exit 3
  fi
  # Global: the EXIT trap runs after this function's locals are gone.
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  set +e
  g -C "$repo" bundle create --quiet "$tmp/lane.bundle" '--branches=factory/*' ${not[@]+"${not[@]}"} \
    >/dev/null 2>"$tmp/err"
  rc=$?
  set -e
  if [ "$rc" -ne 0 ]; then
    cat "$tmp/err" >&2
    if grep -q 'empty bundle' "$tmp/err"; then
      say "nothing to export from $repo"
      exit 3
    fi
    die "git bundle create failed in $repo"
  fi
  cat "$tmp/err" >&2
  cat "$tmp/lane.bundle"
}

cmd_bundle() {
  [ $# -eq 4 ] || [ $# -eq 5 ] || die "$USAGE"
  local project="$1" lane="$2" rel="$3" branch="$4" base="${5:-}" repo out name n
  check_project "$project"
  check_lane "$lane"
  check_rel "$project" "$rel"
  repo="$(target "$(lanes_root)/$lane" "$rel")"
  [ -e "$repo/.git" ] || die "no lane clone at $repo"
  [[ "$branch" =~ ^factory/[A-Za-z0-9._/-]+$ ]] \
    || die "only factory/* branches can be pushed (letters, digits, . _ / -): $branch"
  case "$branch" in *..*|*/|*//*|*/.*|*.lock) die "invalid branch name: $branch" ;; esac
  g -C "$repo" show-ref --verify --quiet "refs/heads/$branch" || die "no such branch in $repo: $branch"
  if [ -z "$base" ]; then
    base="$(g -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD || true)"
    [ -n "$base" ] || die "the lane has no origin/HEAD; pass the base branch (e.g. main)"
  else
    [[ "$base" =~ ^[A-Za-z0-9._/-]+$ ]] || die "invalid base: $base"
    case "$base" in -*|*..*) die "invalid base: $base" ;; esac
    case "$base" in origin/*) ;; *) base="origin/$base" ;; esac
  fi
  g -C "$repo" rev-parse --verify --quiet "refs/remotes/$base^{commit}" >/dev/null \
    || die "no such base in $repo: $base (fetch it first, e.g. with the broker's git_fetch)"
  n="$(g -C "$repo" rev-list --count "refs/remotes/$base..refs/heads/$branch")"
  [ "$n" -gt 0 ] || die "$branch has no commits beyond $base; nothing to push"
  # The one project path a writable role may write; the factory creates it.
  out="$project/.factory/outgoing"
  [ -d "$out" ] && [ ! -L "$out" ] || die "$out is missing (the factory creates it for roles that may push)"
  name="${branch#factory/}"
  [ "$rel" = . ] || name="$rel--$name"
  name="$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '_').bundle"
  g -C "$repo" bundle create --quiet "$out/$name.tmp" "refs/remotes/$base..refs/heads/$branch" >&2 \
    || { rm -f "$out/$name.tmp"; die "git bundle create failed in $repo"; }
  mv -f "$out/$name.tmp" "$out/$name"
  say "bundled $n commit(s), $base..$branch, into $out/$name"
  printf '%s\n' "$name"
}

cmd_review() {
  [ $# -eq 2 ] || [ $# -eq 3 ] || die "$USAGE"
  local project="$1" ref="$2" rel="${3:-.}" src full cand name dir
  check_project "$project"
  check_rel "$project" "$rel"
  [[ "$ref" =~ ^[A-Za-z0-9._/-]+$ ]] || die "invalid ref: $ref"
  case "$ref" in -*|*..*) die "invalid ref: $ref" ;; esac
  src="$(source_of "$project" "$rel")"
  if [[ "$ref" == refs/* ]]; then
    full="$ref"
  else
    full=""
    for cand in "refs/remotes/$ref" "refs/heads/$ref" "refs/tags/$ref"; do
      if g check-ref-format "$cand" && g -C "$src" show-ref --verify --quiet "$cand"; then
        full="$cand"
        break
      fi
    done
    [ -n "$full" ] || die "no such ref in $src: $ref"
  fi
  g check-ref-format "$full" || die "invalid ref: $ref"
  g -C "$src" show-ref --verify --quiet "$full" || die "no such ref in $src: $full"

  name="${full#refs/remotes/}"
  [ "$rel" = . ] || name="$rel--$name"
  name="$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '_')"
  name="$name-$(printf '%s\n%s' "$rel" "$full" | sha256sum | cut -c1-8)"
  # Each lane of a reviewer gets its own checkout, so two lanes reviewing the
  # same ref don't share one.
  case "${FACTORY_LANE:-}" in
    '') ;;
    *[!a-z0-9-]*) die "invalid FACTORY_LANE: $FACTORY_LANE" ;;
    *) name="$FACTORY_LANE--$name" ;;
  esac
  dir="$HOME/review/$name"
  mkdir -p "$HOME/review"
  if [ -e "$dir/.git" ]; then
    say "refreshing $dir from $src"
    set_origin "$dir" "$src"
    g -C "$dir" fetch --quiet --prune --no-recurse-submodules origin >&2 || die "fetch failed in $dir"
  else
    say "cloning $src into $dir"
    g clone --quiet --no-hardlinks -- "$src" "$dir" >&2 || die "clone of $src failed"
  fi
  g -C "$dir" fetch --quiet --no-tags --no-recurse-submodules origin "+$full:refs/factory-review/target" >&2 \
    || die "fetch of $full failed"
  g -C "$dir" checkout --quiet --force --no-recurse-submodules -B review refs/factory-review/target >&2 \
    || die "checkout of $full failed in $dir"
  g -C "$dir" clean --quiet -fd >&2
  init_submodules "$src" "$dir"
  say "checked out $full ($(g -C "$dir" rev-parse --short HEAD)) as branch review"
  (cd "$dir" && pwd -P)
}

[ $# -ge 1 ] || die "$USAGE"
cmd="$1"
shift
case "$cmd" in
  -h|--help|help) sed -n '4,/^# Baked into/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  repos) cmd_repos "$@" ;;
  prepare) cmd_prepare "$@" ;;
  export) cmd_export "$@" ;;
  bundle) cmd_bundle "$@" ;;
  review) cmd_review "$@" ;;
  *) die "$USAGE" ;;
esac
