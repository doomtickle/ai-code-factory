Author: Demo Dev <dev@example.com>
Date:   2026-10-23T09:00:00Z

    Make greet() reject empty names
    
    Adds an optional punctuation argument and trims the name.
    

---
 src/greet.py | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/greet.py b/src/greet.py
index 748e188..7efeea0 100644
--- a/src/greet.py
+++ b/src/greet.py
@@ -1,2 +1,5 @@
-def greet(name):
-    return "hello " + name
+def greet(name, punct="!"):
+    name = name.strip()
+    if not name:
+        raise ValueError("name is empty")
+    return "hello " + name + punct
