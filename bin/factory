    --project "$(basename "$(bound_project)")" "$@"
}

# --- dashboard ---------------------------------------------------------------------
# cmd_dashboard -> scripts/dashboard.py: serves the FC-1984 page on 127.0.0.1 with a
# per-run token, read from the state folder (host Python, stdlib), plus Terminal 0:
# the Coordinator's terminal on a second port, running the fixed argv
# 'sbx run --name $COORDINATOR_SANDBOX' (no shell) when the page presses POWER ON, unless the
# Coordinator is open elsewhere. Its control unit (same second port, its own key)
# writes approval decisions and, each after a confirm step, runs the fixed argvs
# '$ROOT/bin/factory restart' and 'update --yes' (and 'update --plan' to show
# what an update would do). Otherwise it starts only the browser opener, once
# (none with --no-open). Runs in the foreground; Ctrl-C stops it and hangs up
# (a restart or update it started keeps running).
cmd_dashboard() {
  local python
  python="$(resolve_python)"
  "$python" "$SCRIPTS/dashboard.py" --state "$FACTORY_STATE" --roles "$ROOT/roles" \
    --project "$(basename "$(bound_project)")" --coordinator "$COORDINATOR_SANDBOX" "$@"
}

# --- approvals ---------------------------------------------------------------------
