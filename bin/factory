#!/usr/bin/env bash
set -euo pipefail

# factory: one command for the AI code factory. Run `factory help`.

# Resolve the repo root through symlinks (factory setup links this into ~/.local/bin).
# Use BASH_SOURCE, not $0: $0 is this script's path when it is run directly,
# but the caller's when a test sources it to call a function like
# pull_factory without running main (see the guard at the bottom of this file).
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
SCRIPTS="$(cd -P "$(dirname "$src")/.." && pwd)/scripts"
# Always this repo's root, whatever ROOT the environment had: an exported ROOT
# must never redirect a real run (pull_factory even execs "$ROOT/bin/factory").
# A test that sources this file sets ROOT to a fixture checkout afterwards.
ROOT="$(dirname "$SCRIPTS")"

# shellcheck source=../scripts/lib/common.sh
. "$SCRIPTS/lib/common.sh"
# roles.sh initializes the broker/ submodule if needed and dies without it.
# 'factory docs', 'factory help' and 'factory config' need neither, so they skip it: they must
# work on a fresh clone, before 'factory setup' (a test sourcing this file
# always gets roles.sh). 'doctor' and 'setup' skip it too: cmd_doctor checks
# the submodule itself, reports what it finds, and loads roles.sh only when
# broker/ is usable (see doctor_load_roles).
case "${BASH_SOURCE[0]}:${1:-help}" in
  "$0":docs|"$0":config|"$0":help|"$0":-h|"$0":--help|"$0":doctor|"$0":setup) ;;
  *)
    # shellcheck source=../scripts/lib/roles.sh
    . "$SCRIPTS/lib/roles.sh" ;;
esac
# shellcheck source=../scripts/lib/preflight.sh
. "$SCRIPTS/lib/preflight.sh"
# shellcheck source=../scripts/lib/secrets.sh
. "$SCRIPTS/lib/secrets.sh"

readonly HERDR_SESSION_NAME="factory"

if [ -t 1 ]; then B=$'\033[1m' D=$'\033[2m' G=$'\033[32m' Y=$'\033[33m' R=$'\033[31m' N=$'\033[0m'
else B="" D="" G="" Y="" R="" N=""; fi

say() { printf '%s\n' "$*"; }
step() { printf '\n%s==> %s%s\n' "$B" "$*" "$N"; }
ok() { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; }
bad() { printf '  %s✗%s %s\n' "$R" "$N" "$*"; }

confirm() { # confirm QUESTION -> success on y/yes
  local answer
  [ -t 0 ] || return 1
  printf '%s [y/N] ' "$1"
  read -r answer
  case "$answer" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

bound_project() { cat "$FACTORY_BROKER_STATE/project" 2>/dev/null || true; }

usage() {
  cat <<EOF
${B}factory${N}: run a team of sandboxed Claude agents on a project.

${B}Usage${N}
  factory doctor             Check this machine is ready, and say how to fix what isn't
  factory setup              One-time setup: install tools, sign in, build images,
                             apply the security baseline, put 'factory' on your PATH
  factory update [--yes]     Pull the latest factory, rebuild, recreate whatever
                             sandboxes the changes need, and restart
  factory update --plan      Say what 'factory update' would do, changing nothing
                             (but a git fetch): incoming commits, sandboxes it
                             recreates and what each loses
  factory start [dir] [--no-ui] [--layout watch|tabs|web]
                             Start the factory for a project (default: this folder)
                             and open the dashboard in your browser, with the
                             Coordinator's terminal in it; --no-ui opens nothing
                             and prints how to reach the Coordinator and follow
                             the roles. --layout (or FACTORY_LAYOUT) picks the
                             layout: "web" (default) is the dashboard; "watch"
                             opens Herdr with a 'factory watch' pane beside the
                             Coordinator; "tabs" opens Herdr with one tab per
                             role, tailing its transcript. Remembered for next
                             time in $FACTORY_CONFIG/layout
  factory chat               Talk to the Coordinator in this terminal
  factory status             What is running, and for which project
  factory stop               Stop the agents, broker and dispatch bridge
  factory restart            Stop, then start the factory again for its project
                             (the dashboard, if open, keeps running)
  factory logs [name]        Follow a role's work (all its lanes; e.g. developer,
                             or one lane: developer-lane2), or broker / dispatch
  factory watch              Live view of the lanes: a pane per active lane, idle lanes as
                             one line each, tool calls condensed, status and cost in titles
  factory dashboard [--no-open] [--port N]
                             The whole factory on one screen in your browser: the
                             Coordinator's terminal, lanes, spend, broker calls,
                             held writes (local). Its control unit approves and
                             declines held writes and runs restart and update
                             (each after a confirm step). Prints a link with this
                             run's token; 'gui' also works
  factory packet [id|lane]   A job's review packet: task, branch commits and diffstat,
                             tests, broker calls, cost, report (default: the latest;
                             --list for recent jobs)
  factory roles              List roles and what they may do
  factory role new <name> [like]
                             Add a role, copied from an existing one (default: reviewer)
  factory config init [--force]
                             Write the commented example settings into
                             $FACTORY_CONFIG; refuses to overwrite files unless --force
  factory secret save <name> Store a credential once in this machine's keychain
                             (github, gitlab, jira, gemini, npm-registry,
                             approvals-webhook); every broker start
                             then delivers it
  factory secret forget <name>
                             Delete it from the keychain and from the running broker
  factory secret set <name>  Deliver a broker credential to the running broker only
                             (until it is recreated), for machines with no keychain
  factory secret rm <name>   Remove a credential delivered with 'factory secret set'
  factory secret ls          List credentials managed by 'factory secret set'
  factory docs [--print]     Open these docs, with guides, in your browser (offline);
                             --print writes the HTML to stdout instead
  factory analytics          Cost, token and performance report from the audit logs
  factory approvals          Pushes and PRs the gateway is holding for you:
                             list, show <id>, approve <id>, decline <id> --reason ..., watch
  factory reset              Remove the agent sandboxes to switch projects
                             (your Claude login is kept)

${B}Examples${N}
  factory docs
  cd ~/code/my-app && factory start
  factory logs researcher
  factory role new designer researcher
  factory analytics --json | jq '.roles'
EOF
}

# --- setup -------------------------------------------------------------------------
cmd_setup() {
  cmd_doctor || die "fix the problems above, then run 'factory setup' again"

  step "Installing pinned tools (sbx $SBX_VERSION, herdr $HERDR_VERSION)"
  "$SCRIPTS/install-prereqs.sh"
  export PATH="$HOME/.local/bin:$PATH"

  if sbx_not_signed_in; then
    step "Signing in to Docker (sbx)"
    say "Not signed in yet; a browser window opens:"
    sbx login || die "sbx login failed: run 'sbx login' yourself, then 'factory setup' again"
  fi

  step "Building sandbox images"
  local log
  log="$(mktemp)"
  if ! "$SCRIPTS/00-build-templates.sh" 2>&1 | tee "$log" | grep -E '^Building' | sed 's/^/  /'; then
    if grep -q "Not authenticated" "$log"; then
      say "Sign in to Docker to continue (a browser window opens):"
      sbx login
      "$SCRIPTS/00-build-templates.sh" 2>&1 | grep -E '^Building|rror' | sed 's/^/  /'
    else
      tail -20 "$log"
      rm -f "$log"
      die "image build failed"
    fi
  fi
  rm -f "$log"

  step "Applying the security baseline"
  "$SCRIPTS/01-init-security.sh" >/dev/null
  ok "outbound network blocked by default; Anthropic API allowed; local MCP gateway on"

  step "Adding 'factory' to your PATH"
  mkdir -p "$HOME/.local/bin"
  ln -sf "$ROOT/bin/factory" "$HOME/.local/bin/factory"
  ok "linked ~/.local/bin/factory"
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) warn "add this to your shell profile: export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
  esac

  onboarding_hints

  say ""
  say "${G}Setup complete.${N} Next: cd into a project and run ${B}factory start${N}"
}

setup_done() {
  [ "$(sbx settings get mcp.forceLocalGateway 2>/dev/null)" = "true" ] || return 1
  local templates
  templates="$(sbx template ls -q 2>/dev/null)"
  for image in developer reviewer broker; do
    printf '%s' "$templates" | grep -q "factory-$image" || return 1
  done
}

# --- doctor ------------------------------------------------------------------------
# cmd_doctor -> checks everything setup and start need, printing the fix for
# each problem. Fails if anything blocks setup. Changes nothing itself, except
# that it tries once to initialize the broker/ submodule, as every command that
# loads roles.sh does.
#
# doctor_load_roles -> load scripts/lib/roles.sh (the role helpers) once broker/
# is usable; roles.sh dies without broker/tools.txt, so doctor checks that first.
doctor_load_roles() {
  declare -F list_roles >/dev/null && return 0
  # shellcheck source=../scripts/lib/roles.sh
  . "$SCRIPTS/lib/roles.sh"
}

# doctor_secret_tool_probe -> a read-only lookup of a name nothing stores.
# A working secret-tool answers "not found" with exit 1 and no message; one with
# no D-Bus session or no keyring service prints why on stderr. Prints that text
# and fails when it can't answer, and prints nothing and succeeds otherwise.
doctor_secret_tool_probe() {
  local err status=0
  if command -v timeout >/dev/null 2>&1; then
    err="$(timeout 10 secret-tool lookup service factory-doctor-probe 2>&1 >/dev/null </dev/null)" || status=$?
  else
    err="$(secret-tool lookup service factory-doctor-probe 2>&1 >/dev/null </dev/null)" || status=$?
  fi
  if [ "$status" -eq 124 ]; then err="timed out after 10 seconds (is a keyring prompt waiting?)"; fi
  if [ -n "$err" ]; then printf '%s' "$err"; return 1; fi
  return 0
}

cmd_doctor() {
  local problems=0 missing_pkgs="" os linux="" t out status doctor hosts kit kit_hosts missing h r
  os="$(uname -s)"
  [ "$os" = Linux ] && linux=1
  # fail SUMMARY [FIX-TEXT...] -> a problem, with its fix indented beneath (multi-line args allowed)
  fail() {
    bad "$1"; shift
    local l
    for l in "$@"; do [ -z "$l" ] || printf '%s\n' "$l" | sed 's/^/      /'; done
    problems=$((problems + 1))
  }

  step "Platform"
  case "$os:$(uname -m)" in
    Darwin:arm64)
      if [ "$(sw_vers -productVersion | cut -d. -f1)" -ge 14 ]; then ok "macOS $(sw_vers -productVersion), Apple silicon"
      else fail "macOS 14 (Sonoma) or later required"; fi ;;
    Linux:x86_64)
      if out="$(sbx_deb_pin 2>&1)"; then ok "$(os_release_field PRETTY_NAME)$(is_wsl && printf ' (WSL2)')"
      else fail "$(printf '%s' "$out" | head -n1)" "$(printf '%s' "$out" | sed -n '2,$p')"; fi
      if out="$(kvm_check 2>&1)"; then ok "KVM available (/dev/kvm)"
      else fail "$(printf '%s' "$out" | head -n1)" "$(printf '%s' "$out" | sed -n '2,$p')"; fi ;;
    *) fail "unsupported platform $os/$(uname -m): macOS on Apple silicon or Ubuntu 24.04+ x86_64 (including WSL2) only" ;;
  esac

  step "Tools"
  for t in curl:curl jq:jq openssl:openssl git:git column:bsdextrautils; do
    if command -v "${t%%:*}" >/dev/null 2>&1; then ok "${t%%:*}"
    else bad "${t%%:*} not found"; missing_pkgs="$missing_pkgs ${t#*:}"; problems=$((problems + 1)); fi
  done
  if out="$(resolve_python 2>&1)"; then ok "python3 ($out)"
  else bad "${out#error: }"; [ -n "$linux" ] && missing_pkgs="$missing_pkgs python3"; problems=$((problems + 1)); fi
  if [ -n "$missing_pkgs" ]; then
    if [ -n "$linux" ]; then say "      Install them: sudo apt-get update && sudo apt-get install -y$missing_pkgs"
    else say "      Install them with Homebrew: brew install${missing_pkgs/bsdextrautils/}"; fi
  fi

  if [ "$(keychain_backend)" = secret-tool ]; then
    step "Credential store (secret-tool)"
    if out="$(doctor_secret_tool_probe)"; then ok "secret-tool answers"
    else
      warn "secret-tool is installed but can't reach a keyring: ${out:-no reason given}"
      say "      'factory secret save' will fail until it can. Start a keyring (e.g. gnome-keyring) in a desktop"
      say "      session, or skip the keychain: 'factory secret set <name>' delivers a credential without one."
    fi
  fi

  step "Gateway source (broker/ submodule)"
  local roles_ready="" git_err=""
  if [ -f "$ROOT/broker/tools.txt" ]; then
    ok "broker/ is checked out"
    roles_ready=1
  elif ! command -v git >/dev/null 2>&1; then
    warn "skipped: needs git"
  else
    if ! broker_initialized "$ROOT"; then git_err="$(broker_submodule_init "$ROOT")" || true; fi
    if [ -f "$ROOT/broker/tools.txt" ]; then
      ok "broker/ was empty; initialized it"
      roles_ready=1
    else
      fail "$(broker_missing_message "$ROOT" "$git_err" | head -n1)" "$(broker_missing_message "$ROOT" "$git_err" | sed -n '2,$p')"
    fi
  fi
  [ -z "$roles_ready" ] || doctor_load_roles

  step "Docker (builds the sandbox images)"
  if ! command -v docker >/dev/null 2>&1; then
    if [ -n "$linux" ]; then
      fail "docker not found" "Install Docker Engine in this Linux system (docs/setup-wsl.md, step 3):" \
        "  curl -fsSL https://get.docker.com | sudo sh && sudo usermod -aG docker \$USER" \
        "then restart the shell (under WSL: 'wsl --shutdown' in PowerShell, reopen the terminal)."
    else
      fail "docker not found" "Install Docker Desktop: https://docs.docker.com/desktop/setup/install/mac-install/"
    fi
  elif ! out="$(docker info 2>&1 >/dev/null)"; then
    case "$out" in
      *"permission denied"*)
        fail "docker is installed but $(id -un) can't use it" "  sudo usermod -aG docker \$USER" \
          "then restart the shell$(is_wsl && printf " (under WSL: 'wsl --shutdown' in PowerShell)")." ;;
      *)
        if is_wsl && [ "$(ps -p 1 -o comm= 2>/dev/null)" != systemd ]; then
          fail "the Docker daemon isn't running, and WSL started without systemd" \
            "Add to /etc/wsl.conf (sudo nano /etc/wsl.conf):" "  [boot]" "  systemd=true" \
            "then run 'wsl --shutdown' in PowerShell and reopen the terminal."
        elif [ -n "$linux" ]; then
          fail "the Docker daemon isn't running" "  sudo systemctl enable --now docker"
        else
          fail "the Docker daemon isn't running" "Start Docker Desktop."
        fi ;;
    esac
  else
    ok "docker $(docker version --format '{{.Server.Version}}' 2>/dev/null)"
    if docker buildx version >/dev/null 2>&1; then ok "docker buildx"
    else fail "docker buildx not found (the broker image build needs it)" \
      "$([ -n "$linux" ] && echo "  sudo apt-get install -y docker-buildx-plugin" || echo "Update Docker Desktop.")"; fi
  fi

  step "Factory tools"
  if command -v sbx >/dev/null 2>&1 && [ "$(sbx_installed_version)" = "$SBX_VERSION" ]; then ok "sbx $SBX_VERSION"
  else warn "sbx $SBX_VERSION not installed yet ('factory setup' installs it)"; fi
  if command -v herdr >/dev/null 2>&1 && [ "$(herdr_installed_version)" = "$HERDR_VERSION" ]; then ok "herdr $HERDR_VERSION"
  else warn "herdr $HERDR_VERSION not installed yet ('factory setup' installs it)"; fi
  if command -v sbx >/dev/null 2>&1 && [ "$(sbx_installed_version)" = "$SBX_VERSION" ]; then
    if setup_done; then ok "setup done (security baseline applied, images loaded)"
    else warn "setup not finished: run 'factory setup'"; fi
    if claude_login_stored; then ok "Claude login stored"
    else warn "no Claude login yet: 'factory start' walks you through it"; fi
  fi
  if is_wsl; then
    say "  ${D}Keep projects in the Linux filesystem (e.g. ~/code), not under /mnt/c: sandboxes mount${N}"
    say "  ${D}the project folder, and Windows drives are slow and lose file permissions there.${N}"
  fi

  # The gateway's own doctor (broker/passdesk/doctor.py) runs inside the
  # broker sandbox, where the baked-in policy, the state dir and the
  # credential files are. It changes nothing. Its hosts-vs-kit check needs
  # the kit files, which live on the host, so that comparison happens here.
  step "Passdesk (the gateway)"
  if ! command -v sbx >/dev/null 2>&1 || [ "$(sbx_installed_version)" != "$SBX_VERSION" ]; then
    warn "checked once sbx is installed and the broker sandbox exists ('factory setup', then 'factory start')"
  elif ! sandbox_exists "$BROKER_SANDBOX"; then
    warn "broker sandbox not created yet ('factory start' creates it)"
  elif ! sandbox_running "$BROKER_SANDBOX"; then
    warn "broker sandbox is not running ('factory start' starts it); its checks are skipped"
  else
    doctor='cd /opt/factory-broker && PYTHONDONTWRITEBYTECODE=1 python3 -m passdesk.doctor'
    if out="$(sbx exec "$BROKER_SANDBOX" sh -c "$doctor --live --no-color" 2>&1)"; then status=0; else status=$?; fi
    case "$out" in
      *"No module named "*passdesk*)
        warn "the broker image predates the gateway doctor; run 'factory update' to rebuild it" ;;
      *)
        # Its section headers and findings, indented under this step; its own
        # summary line is dropped in favour of this command's.
        printf '%s\n' "$out" | sed -e '/^$/d' -e '/problem(s) found\.\|No problems found\./d' \
          -e 's/^  /    /' -e 's/^==> /    ==> /'
        if [ "$status" -eq 0 ]; then ok "gateway checks passed"
        else fail "the gateway reported problems (above)"; fi
        # Every host the baked-in policy can reach must be in the broker kit(s).
        hosts="$(sbx exec "$BROKER_SANDBOX" sh -c "$doctor --egress-hosts" 2>/dev/null || true)"
        kit_hosts=""
        for kit in "$ROOT/kits/broker/spec.yaml" "$FACTORY_CONFIG/broker-kit/spec.yaml"; do
          [ -f "$kit" ] || continue  # the local broker kit is optional
          kit_hosts="$kit_hosts
$(sed -n 's/^[[:space:]]*-[[:space:]]*"\{0,1\}\([^"[:space:]#]*\).*/\1/p' "$kit")"
        done
        missing=""
        for h in $hosts; do
          case "$h" in \*.*) continue ;; esac  # wildcards: the gateway doctor already warns
          printf '%s\n' "$kit_hosts" | grep -qx "$h" || missing="$missing $h"
        done
        if [ -z "$hosts" ]; then warn "could not list the policy's hosts; kit check skipped"
        elif [ -z "$missing" ]; then ok "every host the policy can reach is in the broker kit"
        else fail "in the broker policy but not in the broker kit:$missing" \
          "add them to kits/broker/spec.yaml (or $FACTORY_CONFIG/broker-kit/spec.yaml), then 'factory update'"; fi ;;
    esac
  fi
  # This machine's role overrides (FACTORY_CONFIG/roles/<role>.conf), checked
  # exactly as `factory start` checks them; no step at all without the folder.
  if [ -d "$FACTORY_CONFIG/roles" ] && [ -z "$roles_ready" ]; then
    step "Role overrides ($FACTORY_CONFIG/roles)"
    warn "skipped: needs the broker/ submodule (see above)"
  elif [ -d "$FACTORY_CONFIG/roles" ]; then
    step "Role overrides ($FACTORY_CONFIG/roles)"
    if out="$( (validate_role_overrides; for r in $(list_roles); do validate_role "$r"; done) 2>&1)"; then
      ok "role overrides are valid"
    else
      fail "${out#error: }" "fix or remove the override, then 'factory start' applies it (docs/guides/04-customize.md)"
    fi
  fi
  approvals_doctor_check
  # A warning, not a problem (owner decision): the fix is a Pro re-copy or a
  # policy edit, and `factory update` must stay usable meanwhile.
  local why
  if [ -n "$roles_ready" ] && why="$(gitlab_mr_unheld)"; then
    warn "GitLab merge requests open without approval: $why (see README: Enabling approvals)"
  fi
  step "sbx CLI reference (docs/reference/sbx-cli.md)"
  if why="$(sbx_reference_problem "$ROOT/docs/reference/sbx-cli.md")"; then warn "$why"
  else ok "matches sbx $SBX_VERSION"; fi

  say ""
  if [ "$problems" -eq 0 ]; then
    say "${G}No problems found.${N}"
  else
    say "${R}$problems problem(s) found.${N} Fix them, then run ${B}factory doctor${N} again."
    return 1
  fi
}

# --- start -------------------------------------------------------------------------
# require_project_commits PROJECT -> die, naming the repo, if any repository
# the roles would work in (project_repos) has no commits: the lane clone and
# the review packet both need a HEAD, and would fail much later without one.
require_project_commits() {
  local project="$1" repo dir
  for repo in $(project_repos "$project"); do
    dir="$project/$repo"
    git "${BROKER_GIT_SAFE[@]}" -C "$dir" rev-parse --verify --quiet 'HEAD^{commit}' >/dev/null 2>&1 \
      || die "$dir is a git repository with no commits yet, so the developer has nothing to branch from. Make the first commit there (git -C '$dir' commit --allow-empty -m 'Initial commit'), then run 'factory start' again."
  done
}

cmd_start() {
  # --no-ui (or FACTORY_NO_UI=1): everything but Herdr. Talk to the Coordinator
  # with `sbx run` in any terminal and follow roles with `factory logs`.
  # --layout (or FACTORY_LAYOUT): "web" (default; GUI first, owner's call of
  # 20 Oct 2026) skips Herdr and ends by running `factory dashboard`, which
  # holds the Coordinator's terminal; "watch" opens Herdr with a `factory
  # watch` pane beside the Coordinator and no per-role transcript tabs;
  # "tabs" opens Herdr with one tab per role. --no-ui ignores it.
  # --no-dashboard (internal, from cmd_update and cmd_restart): with "web",
  # finish instead of running the dashboard in the foreground, so `factory
  # update --yes` and `factory restart` return.
  local target="" project current no_ui="${FACTORY_NO_UI:-}" layout_flag="" layout no_dashboard=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-ui) no_ui=1 ;;
      --no-dashboard) no_dashboard=1 ;;
      --layout)
        [ $# -ge 2 ] || die "usage: factory start [dir] [--no-ui] [--layout watch|tabs|web]"
        layout_flag="$2"
        shift ;;
      -*) die "usage: factory start [dir] [--no-ui] [--layout watch|tabs|web]" ;;
      *) [ -z "$target" ] || die "usage: factory start [dir] [--no-ui] [--layout watch|tabs|web]"; target="$1" ;;
    esac
    shift
  done
  layout="$(resolve_layout "$layout_flag" "${FACTORY_LAYOUT:-}")"
  target="${target:-.}"
  [ -d "$target" ] || die "no such directory: $target"
  project="$(cd "$target" && pwd -P)"
  require_sbx
  [ "$no_ui" = 1 ] || [ "$layout" = web ] || require_herdr
  setup_done || die "the factory is not set up yet: run 'factory setup' first"
  require_project_commits "$project"
  case "$project" in
    /mnt/[a-z]/*) is_wsl && warn "$project is on a Windows drive: sandboxes will be slow and file permissions unreliable. Clone it into the Linux filesystem (e.g. ~/code) instead." ;;
  esac

  current="$(bound_project)"
  if [ -n "$current" ] && [ "$current" != "$project" ] && sbx ls -q | grep -q '^factory-'; then
    say "The factory is currently set up for ${B}$current${N}."
    if confirm "Switch to $project? This removes the agent sandboxes (your Claude login is kept)."; then
      cmd_reset --yes
    else
      die "not switching. Run 'factory start $current' to open the current project."
    fi
  fi

  if [ "$no_ui" = 1 ]; then
    FACTORY_NO_UI=1 FACTORY_LAYOUT="$layout" "$SCRIPTS/02-launch-factory.sh" "$project"
    onboarding_hints
    say ""
    say "Factory running, without Herdr."
    say "  Talk to the Coordinator:  ${B}factory chat${N}"
    say "  Watch every lane:         ${B}factory watch${N}"
    say "  Follow one role's log:    ${B}factory logs <role>${N}  (roles: $(list_roles | tr '\n' ' '))"
    say "  Stop everything:          ${B}factory stop${N}"
  elif [ "$layout" = web ]; then
    FACTORY_LAYOUT=web "$SCRIPTS/02-launch-factory.sh" "$project"
    onboarding_hints
    say ""
    if [ -n "$no_dashboard" ]; then
      say "Factory running. Run ${B}factory dashboard${N} to open it."
      return
    fi
    say "Factory running. Opening the dashboard: talk to the Coordinator on its screen."
    say "Ctrl-C closes the dashboard (and the Coordinator's terminal); the factory keeps"
    say "running. Reopen it with ${B}factory dashboard${N}; stop everything with ${B}factory stop${N}."
    cmd_dashboard
  elif [ "${HERDR_ENV:-}" = "1" ]; then
    FACTORY_LAYOUT="$layout" "$SCRIPTS/02-launch-factory.sh" "$project"
    onboarding_hints
    say ""
    say "Open the ${B}code-factory${N} workspace in Herdr and talk to the Coordinator."
  else
    FACTORY_HERDR_SESSION="$HERDR_SESSION_NAME" FACTORY_LAYOUT="$layout" "$SCRIPTS/02-launch-factory.sh" "$project"
    onboarding_hints
    if [ "${FACTORY_NO_ATTACH:-}" = "1" ]; then
      say "Factory running. Open it with: herdr session attach $HERDR_SESSION_NAME"
      return
    fi
    say "Opening Herdr. To leave it running in the background press ${B}Ctrl+B${N} then ${B}Q${N}; reopen with ${B}factory start${N}."
    sleep 2
    exec herdr session attach "$HERDR_SESSION_NAME"
  fi
}

# jira_cloud_id_set -> success if [jira].cloud_id is set to something other
# than empty or the all-zero placeholder UUID from config.example/.
jira_cloud_id_set() {
  local id
  id="$(policy_string jira cloud_id)"
  [ -n "$id" ] && [ -n "${id//[0-]/}" ]
}

git_push_enabled() {
  policy_value git repos | grep -qE '\[.*[^][:space:]].*\]'
}

# github_repos_listed -> success if some [git].repos entry is a GitHub owner/name
# (its first segment has no dot or port; a host-qualified entry is on GitLab).
github_repos_listed() {
  policy_value git repos | grep -o '"[^"]*"' | tr -d '"' \
    | awk -F/ 'NF >= 2 && $1 !~ /[.:]/ { f = 1 } END { exit !f }'
}

# keychain_has SERVICE: scripts/lib/secrets.sh (macOS Keychain, Linux
# secret-tool, or the Windows Credential Manager on WSL2).

# keychain_warn_missing SERVICE MESSAGE -> warn MESSAGE if the keychain has
# no SERVICE; if it is locked or unavailable (keychain_has status 2), say
# that instead, since whether SERVICE is stored can't be told.
keychain_warn_missing() {
  local rc=0
  keychain_has "$1" || rc=$?
  case "$rc" in
    0) ;;
    1) warn "$2" ;;
    *) warn "the keychain is locked or unavailable, so $1 couldn't be checked; unlock it and run this again" ;;
  esac
}

# any_jira_tool_granted -> success if the Coordinator or any role is granted a
# jira_* broker tool (jira_my_issues, jira_get_issue). Other broker tools
# (web_fetch, npm_fetch, ...) don't need a Jira token, so warning on any
# BROKER_TOOLS grant would be a false positive for roles/setups that never
# touch Jira.
any_jira_tool_granted() {
  local r
  case " $(coordinator_broker_tools) " in *" jira_"*) return 0 ;; esac
  for r in $(list_roles); do
    case " $(role_get "$r" BROKER_TOOLS) " in *" jira_"*) return 0 ;; esac
  done
  return 1
}

# gitlab_needs_token -> success if the policy sets [gitlab].url: the git tools
# and gitlab_create_mr then need the gitlab credential (a file, as sbx can't
# inject it).
gitlab_needs_token() {
  # Either TOML string form ("..." or '...'), as long as it isn't empty.
  policy_value gitlab url | grep -qE "^[[:space:]]*(\"[^\"]+\"|'[^']+')"
}

# gitlab_mr_unheld -> prints why, and succeeds, when GitLab merge requests would
# open without approval although other writes are held: gitlab_create_mr is
# granted and [gitlab].url set, but the local [approvals].tools list leaves it
# out. Silent otherwise: no list or tools = [] means holds are off altogether
# (the gateway holds nothing until the list names a tool).
gitlab_mr_unheld() {
  local r granted="" tools
  for r in $(list_roles); do
    case " $(role_get "$r" BROKER_TOOLS) " in *" gitlab_create_mr "*) granted=1 ;; esac
  done
  [ -n "$granted" ] && gitlab_needs_token || return 1
  tools="$(policy_value approvals tools || true)"
  [ -n "$tools" ] || return 1  # no list: holds are off
  case "$tools" in *'"gitlab_create_mr"'*) return 1 ;; esac
  [ -n "$(printf '%s' "$tools" | tr -d '[] \t')" ] || return 1  # tools = []: nothing is held at all
  printf '%s\n' "[approvals].tools is set without \"gitlab_create_mr\""
}

# npm_private_registry_needs_token -> success if a role is granted npm_fetch and
# the policy names a private npm registry (which needs the keychain credential).
npm_private_registry_needs_token() {
  local r granted=""
  for r in $(list_roles); do
    case " $(role_get "$r" BROKER_TOOLS) " in *" npm_fetch "*) granted=1 ;; esac
  done
  [ -n "$granted" ] || return 1
  [ -n "$(policy_string packages npm_private_registry)" ]
}

# approvals_summary -> prints "pending oldest_min expired_unhandled decided" from
# scripts/approvals.py summary (see its --help): pending counts only cards no
# one has decided; decided ones wait for the agent's retry, not for a person.
# Fails with nothing printed
# when holds aren't in use (no approvals dir yet, or ever) or python3
# isn't available; never dies, so callers stay inert rather than erroring.
approvals_summary() {
  local python
  [ -d "$FACTORY_BROKER_STATE/approvals/pending" ] || return 1
  python="$(resolve_python 2>/dev/null)" || return 1
  "$python" "$SCRIPTS/approvals.py" --state "$FACTORY_BROKER_STATE" summary 2>/dev/null
}

# approvals_status_line -> for `factory status`: one line when there is at
# least one undecided or decided-but-not-yet-retried card, nothing otherwise
# (holds off, or no cards).
approvals_status_line() {
  local out pending oldest decided line
  out="$(approvals_summary)" || return 0
  set -- $out
  pending="${1:-0}"
  oldest="${2:-0}"
  decided="${4:-0}"
  [ "${pending:-0}" -gt 0 ] || [ "${decided:-0}" -gt 0 ] || return 0
  if [ "${pending:-0}" -gt 0 ]; then
    line="$pending pending (oldest $oldest min)"
  else
    line="none pending"
  fi
  [ "${decided:-0}" -gt 0 ] && line="$line; $decided decided, waiting for the agent's retry"
  say "${B}Approvals:${N} $line - factory approvals"
}

# approvals_doctor_check -> for `factory doctor`: warn (not fail) about any
# expired card with no decision that still matches it; nothing printed when
# there are none, or when holds aren't in use.
approvals_doctor_check() {
  local out expired
  out="$(approvals_summary)" || return 0
  set -- $out
  expired="${3:-0}"
  [ "${expired:-0}" -gt 0 ] || return 0
  warn "$expired expired approval(s) with no decision: run 'factory approvals' (the agent's retry makes a fresh card)"
}

onboarding_hints() {
  local stale
  if [ -z "${FACTORY_UPDATING:-}" ]; then
    stale="$(stale_sandboxes | tr '\n' ' ')"
    [ -z "$stale" ] || warn "out of date (made from an older image or kit): ${stale% }; run 'factory update' to recreate them"
  fi
  if ! claude_login_stored; then
    warn "first time: type /login in the Coordinator (POWER ON on the dashboard) to sign in with your Claude subscription, then run 'factory start' again (or press RESTART on the dashboard) to create the role sandboxes"
  fi
  if git_push_enabled; then
    local sbx_secrets
    sbx_secrets="$(sbx secret ls 2>/dev/null || true)"
    if printf '%s\n' "$sbx_secrets" | awk '$1 == "(global)" && $3 == "github" { f = 1 } END { exit !f }'; then
      warn "a global GitHub token is stored, so sbx injects it for every sandbox, not just the broker. Run 'factory secret save github', then remove the global one: sbx secret rm github"
    elif github_repos_listed && ! printf '%s\n' "$sbx_secrets" | grep -q " github "; then
      warn "git push/PR is enabled but no GitHub token is stored: run 'factory secret save github' (see README: Enabling git push and pull requests)"
    fi
  fi
  if any_jira_tool_granted; then
    keychain_warn_missing factory-jira "Jira tools are granted but no token is stored in the keychain (see README: Enabling Jira)"
    jira_cloud_id_set || warn "Jira tools are granted but [jira].cloud_id is not set; set it in $FACTORY_CONFIG/policy.toml (see README: Enabling Jira)"
  fi
  if npm_private_registry_needs_token; then
    keychain_warn_missing factory-npm-registry "npm_fetch can't download private npm packages until a token is stored in the keychain (see README: Enabling a private npm registry)"
  fi
  if gitlab_needs_token; then
    keychain_warn_missing factory-gitlab "[gitlab].url is set but no GitLab token is stored: run 'factory secret save gitlab' (see README: Enabling GitLab)"
  fi
  local why
  if why="$(gitlab_mr_unheld)"; then
    warn "GitLab merge requests open without approval: $why (see README: Enabling approvals)"
  fi
}

# --- chat --------------------------------------------------------------------------
# cmd_chat -> open the Coordinator sandbox in this terminal, the same thing
# 'sbx run --name factory-coordinator' does; 'factory start' creates it.
cmd_chat() {
  require_sbx
  sandbox_exists "$COORDINATOR_SANDBOX" \
    || die "the coordinator sandbox doesn't exist yet; run 'factory start' first"
  # A second 'sbx run' would start a second Coordinator in the same VM.
  ! coordinator_attached \
    || die "the Coordinator is already open elsewhere (the dashboard, a Herdr pane or another 'factory chat'); close it there first"
  exec sbx run --name "$COORDINATOR_SANDBOX" "$@"
}

# --- status ------------------------------------------------------------------------
cmd_status() {
  require_sbx
  local project code pid
  project="$(bound_project)"
  say "${B}Project${N}   ${project:-${D}none yet (run factory start)${N}}"
  if local_settings_present; then
    say "${B}Local settings${N} $FACTORY_CONFIG"
  else
    say "${B}Local settings${N} ${D}none (see config.example/)${N}"
  fi
  if [ -d "$ROOT/.broker" ] || [ -d "$ROOT/.dispatch" ] || [ -d "$ROOT/.roles" ]; then
    warn "state is still inside the repo; factory start moves it to $FACTORY_STATE"
  fi

  code="$(curl -s -o /dev/null -w '%{http_code}' -m 2 -X POST -d '{}' "http://127.0.0.1:$BROKER_PORT/mcp" || true)"
  if [ "$code" = "401" ]; then ok "broker running (127.0.0.1:$BROKER_PORT)"; else bad "broker not running"; fi
  pid="$(cat "$FACTORY_DISPATCH_STATE/pid" 2>/dev/null || true)"
  if [ -n "$pid" ] && ps -p "$pid" -o command= 2>/dev/null | grep -qF "$ROOT/dispatch/server.py"; then
    ok "dispatch bridge running (pid $pid)"
  else
    bad "dispatch bridge not running"
  fi
  if claude_login_stored; then ok "Claude login stored"
  else warn "no Claude login yet: type /login in the Coordinator (POWER ON on the dashboard), then run 'factory start' again"; fi

  local coord_tools
  coord_tools="$(coordinator_broker_tools)"
  say "${B}Coordinator broker tools${N} ${coord_tools:-none}"
  if any_jira_tool_granted; then
    keychain_warn_missing factory-jira "Jira keychain entry (\"factory-jira\") not found"
    jira_cloud_id_set || warn "[jira].cloud_id is not set (see README: Enabling Jira)"
  fi
  if npm_private_registry_needs_token; then
    keychain_warn_missing factory-npm-registry "private npm registry keychain entry (\"factory-npm-registry\") not found"
  fi
  if gitlab_needs_token; then
    keychain_warn_missing factory-gitlab "GitLab keychain entry (\"factory-gitlab\") not found"
  fi
  local why
  if why="$(gitlab_mr_unheld)"; then
    warn "GitLab merge requests open without approval: $why"
  fi
  approvals_status_line

  local r role_list=""
  for r in $(list_roles); do role_list="$role_list${role_list:+, }$r ($(lanes_label "$r"))"; done
  say "${B}Roles${N} ${role_list:-none}"

  say ""
  say "${B}Sandboxes${N}"
  sbx ls --json | jq -r '.sandboxes[] | select(.name | startswith("factory-")) | "  \(.name)\t\(.status)"' \
    | column -t -s "$(printf '\t')" | sed "s/running/${G}running${N}/; s/stopped/${D}stopped${N}/"
  say ""
  say "${D}Follow a role: factory logs <role>   Roles: factory roles${N}"
}

# --- stop / reset ------------------------------------------------------------------
cmd_stop() {
  "$SCRIPTS/03-stop-factory.sh"
}

# cmd_restart -> stop the factory (03-stop-factory.sh: the dispatch bridge and
# every factory-* sandbox; never the dashboard), then start it again for the
# project it is bound to. With the "web" layout it doesn't open a dashboard
# (one may be open already: the control unit's RESTART key runs this).
cmd_restart() {
  local project
  [ $# -eq 0 ] || die "usage: factory restart"
  project="$(bound_project)"
  [ -n "$project" ] || die "the factory isn't bound to a project yet: run 'factory start' in one"
  [ -d "$project" ] || die "the factory's project $project no longer exists: run 'factory start' in another"
  require_sbx
  step "Stopping the factory"
  "$SCRIPTS/03-stop-factory.sh"
  step "Starting it again for $project"
  cmd_start "$project" --no-dashboard
}

cmd_reset() {
  local sandboxes
  require_sbx
  sandboxes="$(sbx ls -q | grep '^factory-' || true)"
  if [ "${1:-}" != "--yes" ]; then
    say "This removes these sandboxes: $(printf '%s ' $sandboxes)"
    say "Your Claude login, roles and settings are kept."
    confirm "Continue?" || die "cancelled"
  fi
  "$SCRIPTS/03-stop-factory.sh" >/dev/null
  if [ -n "$sandboxes" ]; then
    # shellcheck disable=SC2086 # one argument per sandbox
    sbx rm --force $sandboxes >/dev/null
    ok "removed $(printf '%s ' $sandboxes)"
  fi
  rm -f "$FACTORY_BROKER_STATE/project" "$FACTORY_DISPATCH_STATE/project"
  rm -f "$FACTORY_DISPATCH_STATE"/sessions/* 2>/dev/null || true
  ok "factory is no longer bound to a project"
}

# --- logs / roles ------------------------------------------------------------------
cmd_logs() {
  local name="${1:-}"
  case "$name" in
    "")
      say "Usage: factory logs <name>   where <name> is one of:"
      say "  $(list_roles | tr '\n' ' ')broker dispatch"
      ;;
    broker|dispatch)
      local file="$FACTORY_STATE/$name/audit.jsonl"
      [ -f "$file" ] || die "no $name log yet"
      tail -n 30 -F "$file" | jq -r --unbuffered \
        '[.ts[11:19], (.role // ""), (.tool // .event // ""), (.decision // .status // (if .tool then .event else null end) // ""), (.reason // "")] | map(select(. != "")) | join("  ")'
      ;;
    *)
      # A role: every lane's transcript (with several, tail heads each chunk
      # with its file name). Or one lane of a role, e.g. developer-lane2.
      local lane lanes logs=()
      printf '%s' "$name" | grep -Eqx '[a-z][a-z0-9-]{1,40}' || die "unknown role '$name' (see: factory roles)"
      if [ -f "$ROOT/roles/$name/role.conf" ]; then
        lanes="$(role_lane_names "$name")"
      else
        case "$name" in
          *-lane[0-9]*) lane="${name%-lane*}" ;;
          *) lane="" ;;
        esac
        [ -n "$lane" ] && [ -f "$ROOT/roles/$lane/role.conf" ] && role_lane_names "$lane" | grep -qx -- "$name" \
          || die "unknown role '$name' (see: factory roles; one lane: <role>-lane<N>, N up to its LANES)"
        lanes="$name"
      fi
      mkdir -p "$FACTORY_DISPATCH_STATE/logs"
      for lane in $lanes; do
        touch "$FACTORY_DISPATCH_STATE/logs/$lane.log"
        logs+=("$FACTORY_DISPATCH_STATE/logs/$lane.log")
      done
      tail -n 100 -F "${logs[@]}"
      ;;
  esac
}

# cmd_packet [<job-id> | latest | <lane> | --list] -> print a job's review
# packet, written by the dispatch bridge after every job to
# dispatch/packets/<job-id>.md in the state folder. Job ids start with the
# job's timestamp, so reverse name order is newest first.
cmd_packet() {
  local dir="$FACTORY_DISPATCH_STATE/packets" which="${1:-latest}" f id
  [ $# -le 1 ] || die "usage: factory packet [<job-id> | latest | <lane> | --list]"
  [ -d "$dir" ] && [ -n "$(ls -A "$dir" 2>/dev/null)" ] \
    || die "no review packets yet (the dispatch bridge writes one per job to $dir)"
  case "$which" in
    --list|-l|list)
      ls -1r "$dir" | sed -n 's/\.md$//p' | head -n 20 | while IFS= read -r id; do
        printf '%s  %s\n' "$id" "$(sed -n '1s/^# //p' "$dir/$id.md")"
      done
      return ;;
    latest) f="$dir/$(ls -1r "$dir" | head -n 1)" ;;
    *)
      printf '%s' "$which" | grep -Eq '^[A-Za-z0-9-]{1,80}$' || die "not a job id or lane: $which"
      if [ -f "$dir/$which.md" ]; then
        f="$dir/$which.md"
      else
        # A lane name: its newest packet.
        f="$(grep -l -x -- "- Lane: $which" "$dir"/*.md 2>/dev/null | sort -r | head -n 1 || true)"
        [ -n "$f" ] || die "no packet for job or lane '$which' (see: factory packet --list)"
      fi ;;
  esac
  cat "$f"
}

# lanes_label ROLE -> "1 lane" / "3 lanes": how many jobs ROLE runs at once
lanes_label() {
  local n
  n="$(role_lanes "$1")"
  if [ "$n" = 1 ]; then echo "1 lane"; else echo "$n lanes"; fi
}

cmd_roles() {
  local r
  for r in $(list_roles); do
    printf '%s%-18s%s %-9s %-8s %s\n' "$B" "$r" "$N" \
      "$( [ "$(role_get "$r" WORKSPACE)" = rw ] && echo "branches" || echo "read-only")" \
      "$(lanes_label "$r")" "$(role_get "$r" DESCRIPTION)"
    printf '  %snetwork tools: %s%s\n' "$D" "$(role_get "$r" BROKER_TOOLS | sed 's/ /, /g; s/^$/none/')" "$N"
    [ ! -f "$(role_override_file "$r")" ] \
      || printf '  %slocal overrides: %s%s\n' "$D" "$(role_override_file "$r")" "$N"
  done
}

cmd_role() {
  case "${1:-}" in
    new) shift; "$SCRIPTS/new-role.sh" "$@" ;;
    *) die "usage: factory role new <name> [like]" ;;
  esac
}

# --- secret --------------------------------------------------------------------------
# For machines with no OS keychain (e.g. WSL2, which has neither macOS
# Keychain nor secret-tool), so Jira, Gemini, the private npm registry token, the GitLab token
# and the approvals webhook URL can still be delivered. Shares its remote delivery/revocation code with
# scripts/start-broker.sh's keychain-based path (scripts/lib/secrets.sh) and
# marks the name as manually managed, so the next 'factory start' does not
# try to revoke it for having no (or an empty) keychain entry.
require_broker_running_for_secret() {
  require_sbx
  sandbox_running "$BROKER_SANDBOX" \
    || die "the broker sandbox is not running; run 'factory start' first"
}

cmd_secret_set() {
  [ $# -eq 1 ] || die "usage: factory secret set <name>"
  local name="$1" value
  secret_name_valid "$name" \
    || die "unknown secret '$name' (one of: $FACTORY_SECRET_NAMES)"
  require_broker_running_for_secret

  value="$(read_secret_value "$name"; printf x)"; value="${value%x}"  # x: keep trailing newlines exact

  printf '%s' "$value" | secret_deliver_file "$BROKER_SANDBOX" "$name" \
    || die "could not deliver '$name' to the broker sandbox"
  secret_mark_manual "$name" \
    || die "delivered '$name' but could not record it as managed by 'factory secret'; the next 'factory start' may remove it"
  ok "delivered '$name' to the broker sandbox; 'factory start' will no longer touch it from the keychain"
}

# read_secret_value NAME -> the value from a hidden prompt (terminal) or all of
# stdin, minus exactly one trailing newline; dies on an empty value.
read_secret_value() {
  local value
  if [ -t 0 ]; then
    printf 'Value for %s (input hidden): ' "$1" >&2
    IFS= read -rs value || true
    printf '\n' >&2
  else
    # The trailing "x" sentinel stops "$(...)" from stripping every trailing
    # newline itself; then exactly one ("echo token | ...") is removed.
    value="$(cat; printf x)"
    value="${value%x}"
    case "$value" in *$'\n') value="${value%$'\n'}" ;; esac
  fi
  [ -n "$value" ] || die "empty value for '$1'"
  printf '%s' "$value"
}

# cmd_secret_save NAME -> store NAME once in this machine's keychain
# (factory-<NAME>: macOS Keychain, Linux secret-tool, or the Windows
# Credential Manager on WSL2), so every broker start from now on delivers it
# - including after 'factory update' or 'factory reset' recreate the broker.
# NAME is one of the broker credential files, or "github" (the broker-scoped
# sbx secret). If the broker is running, it gets the value right away.
cmd_secret_save() {
  [ $# -eq 1 ] || die "usage: factory secret save <name>"
  local name="$1" backend value
  keychain_name_valid "$name" \
    || die "unknown secret '$name' (one of: $FACTORY_KEYCHAIN_NAMES)"
  backend="$(keychain_backend)"
  case "$backend" in
    macos)
      [ -t 0 ] || die "on macOS run 'factory secret save $name' in a terminal: Keychain prompts for the value itself"
      say "Keychain will ask for the value of $name twice."
      security add-generic-password -U -s "factory-$name" -a factory -w \
        || die "could not save factory-$name in the Keychain" ;;
    secret-tool|wincred)
      value="$(read_secret_value "$name"; printf x)"; value="${value%x}"  # x: keep trailing newlines exact
      printf '%s' "$value" | keychain_store "factory-$name" \
        || die "could not save factory-$name in the keychain ($backend)"
      unset value ;;
    *)
      die "this machine has no keychain the factory can use (macOS Keychain, secret-tool, or Windows Credential Manager on WSL2); use 'factory secret set $name' after each broker start instead" ;;
  esac
  keychain_has "factory-$name" || die "saved factory-$name, but reading it back failed"
  ok "saved factory-$name in the keychain ($backend); every broker start delivers it from now on"

  if [ "$name" != github ]; then secret_unmark_manual "$name"; fi  # the keychain manages it now
  if command -v sbx >/dev/null 2>&1 && sandbox_running "$BROKER_SANDBOX"; then
    if [ "$name" = github ]; then
      github_sync_from_keychain
    else
      secret_sync_from_keychain "$name" >/dev/null && ok "delivered '$name' to the running broker"
    fi
  else
    say "The broker isn't running; 'factory start' will deliver it."
  fi
}

# secret_forget_broker_copy NAME -> remove the broker's copy of NAME (the file,
# or the broker-scoped sbx secret). Status: 0 removed; 1 it could not be
# removed (it may still be active); 2 not attempted, because sbx is missing or
# the broker isn't running (the copy is untouched). Never prints a value.
secret_forget_broker_copy() {
  local name="$1" listing
  command -v sbx >/dev/null 2>&1 && sandbox_running "$BROKER_SANDBOX" || return 2
  if [ "$name" = github ]; then
    if ! sbx secret rm github --sandbox "$BROKER_SANDBOX" -f >/dev/null 2>&1; then
      # sbx may refuse because there is nothing to remove; trust only a listing.
      listing="$(sbx secret ls 2>/dev/null)" || return 1
      if printf '%s\n' "$listing" | awk -v s="$BROKER_SANDBOX" '$1 == s && $3 == "github" { f = 1 } END { exit !f }'; then
        return 1
      fi
    fi
    ok "removed the broker's GitHub token"
  else
    secret_revoke_file "$BROKER_SANDBOX" "$name" >/dev/null 2>&1 || return 1
    secret_unmark_manual "$name"
    ok "removed '$name' from the broker sandbox"
  fi
}

# secret_forget_die NAME BROKER_STATUS KEYCHAIN_PROBLEM FIX -> die with a
# message that says truthfully what happened to the broker's copy
# (secret_forget_broker_copy's status) and what happened to the keychain entry.
secret_forget_die() {
  local name="$1" brc="$2" problem="$3" fix="$4" head
  case "$brc" in
    0) head="the broker's copy of '$name' is revoked, but factory-$name could not be deleted from the keychain ($problem)" ;;
    2) head="the broker isn't running, so its copy of '$name' was NOT touched and may still be active in the stopped broker; factory-$name could not be deleted from the keychain either ($problem)" ;;
    *) head="could not remove '$name' from the broker sandbox, so it may still be active; factory-$name could not be deleted from the keychain either ($problem)" ;;
  esac
  case "$brc" in
    2) die "$head. $fix, then run 'factory secret forget $name' again before the next 'factory start'" ;;
    *) die "$head. $fix, then run 'factory secret forget $name' again" ;;
  esac
}

# cmd_secret_forget NAME -> delete factory-<NAME> from the keychain, and its
# copy in the running broker. If the keychain entry can't be deleted (locked, or
# the delete failed), the broker copy is still removed first: forget is how a
# leaked token is killed. What was and wasn't revoked is always stated.
cmd_secret_forget() {
  [ $# -eq 1 ] || die "usage: factory secret forget <name>"
  local name="$1"
  keychain_name_valid "$name" \
    || die "unknown secret '$name' (one of: $FACTORY_KEYCHAIN_NAMES)"
  keychain_delete "factory-$name"
  local rc=0 brc=0
  keychain_has "factory-$name" || rc=$?
  case "$rc" in
    1) ;;
    0)
      secret_forget_broker_copy "$name" || brc=$?
      secret_forget_die "$name" "$brc" "the delete failed, so the next 'factory start' would deliver it again" \
        "Delete it by hand (e.g. in your keychain app)" ;;
    *)
      secret_forget_broker_copy "$name" || brc=$?
      secret_forget_die "$name" "$brc" "the keychain is locked or unavailable" "Unlock it" ;;
  esac
  ok "deleted factory-$name from the keychain"
  secret_forget_broker_copy "$name" || brc=$?
  case "$brc" in
    0) ;;
    2) warn "the broker isn't running, so its copy of '$name' was not touched and may still be active; start the broker and run 'factory secret forget $name' again to remove it" ;;
    *) die "deleted factory-$name from the keychain, but could not remove '$name' from the broker sandbox; it may still be active" ;;
  esac
}

cmd_secret_rm() {
  [ $# -eq 1 ] || die "usage: factory secret rm <name>"
  local name="$1"
  secret_name_valid "$name" \
    || die "unknown secret '$name' (one of: $FACTORY_SECRET_NAMES)"
  require_broker_running_for_secret

  secret_revoke_file "$BROKER_SANDBOX" "$name" \
    || die "could not remove '$name' from the broker sandbox; it may still be active"
  secret_unmark_manual "$name"
  ok "removed '$name' from the broker sandbox"
  if keychain_has "factory-$name"; then
    warn "a keychain entry for 'factory-$name' still exists; the next 'factory start' will deliver it again. To prevent that: factory secret forget $name"
  fi
}

cmd_secret_ls() {
  local dir found=""
  dir="$(secret_manual_dir)"
  if [ -d "$dir" ]; then
    local f
    for f in "$dir"/*; do
      [ -e "$f" ] || continue
      found=1
      say "  $(basename "$f")"
    done
  fi
  [ -n "$found" ] || say "No secrets are managed with 'factory secret set' (see: factory secret)."
}

cmd_secret() {
  case "${1:-}" in
    set) shift; cmd_secret_set "$@" ;;
    rm) shift; cmd_secret_rm "$@" ;;
    ls) shift; cmd_secret_ls "$@" ;;
    save) shift; cmd_secret_save "$@" ;;
    forget) shift; cmd_secret_forget "$@" ;;
    *) die "usage: factory secret <save|forget|set|rm|ls> <name>" ;;
  esac
}

# --- analytics ---------------------------------------------------------------------
cmd_analytics() {
  local python
  python="$(resolve_python)"
  "$python" "$SCRIPTS/analytics.py" --state "$FACTORY_STATE" "$@"
}

# --- docs ------------------------------------------------------------------------
# cmd_docs [--print] -> the README, docs/setup-wsl.md and docs/guides/*.md as
# one self-contained HTML page, generated by scripts/docs.py at run time.
# Printed to stdout with --print or when stdout isn't a terminal; otherwise
# written to $FACTORY_STATE/docs/index.html and opened in the browser. Needs
# only python3: no sbx, Docker or broker/, so it works before 'factory setup'.
cmd_docs() {
  local print="" arg python out opener
  for arg in "$@"; do
    case "$arg" in
      --print) print=1 ;;
      *) die "usage: factory docs [--print]" ;;
    esac
  done
  python="$(resolve_python)"
  if [ -n "$print" ] || ! stdout_is_tty; then
    "$python" "$SCRIPTS/docs.py" --root "$ROOT"
    return
  fi
  [ "$(id -u)" != 0 ] || warn "running as root: the factory keeps its state in root's home ($FACTORY_STATE). Run factory as your own user, without sudo."
  out="$FACTORY_STATE/docs/index.html"
  (umask 077 && mkdir -p "$FACTORY_STATE/docs")  # private, like the rest of the state dir
  "$python" "$SCRIPTS/docs.py" --root "$ROOT" --out "$out" || die "could not build the docs"
  if { [ -n "${WSL_DISTRO_NAME:-}" ] || is_wsl; } && open_docs_on_windows "$out"; then
    return 0
  fi
  opener="$(docs_opener)"
  if [ -n "$opener" ]; then
    # Detached and silenced: some openers block, or chatter on stderr.
    ( "$opener" "$out" >/dev/null 2>&1 & ) || true
    say "Opening the docs in your browser: $out"
  else
    say "Docs written to $out"
    say "Open that file in a web browser."
  fi
}

stdout_is_tty() { [ -t 1 ]; }

# open_docs_on_windows FILE -> on WSL, copy FILE into the Windows user's temp
# folder and open it with the Windows default browser. A Windows browser can't
# always read a page inside the Linux filesystem (never one under /root), and
# wslview isn't reliable everywhere, so the page goes where Windows can read it.
# Fails (so the caller falls back) when Windows interop isn't available.
open_docs_on_windows() {
  local win_tmp dir copy win_copy
  command -v cmd.exe >/dev/null 2>&1 && command -v wslpath >/dev/null 2>&1 \
    && command -v explorer.exe >/dev/null 2>&1 || return 1
  # From a Linux folder cmd.exe warns about the UNC path (on stderr) and still answers.
  win_tmp="$(cmd.exe /d /c 'echo %TEMP%' 2>/dev/null | tr -d '\r')" || return 1
  case "$win_tmp" in [A-Za-z]:\\*) ;; *) return 1 ;; esac
  dir="$(wslpath -u "$win_tmp" 2>/dev/null)" && [ -d "$dir" ] || return 1
  copy="$dir/ai-code-factory-docs.html"
  cp "$1" "$copy" 2>/dev/null || return 1
  win_copy="$(wslpath -w "$copy")" || return 1
  # explorer.exe hands the file to the default browser; it exits 1 even on success.
  ( explorer.exe "$win_copy" >/dev/null 2>&1 & ) || true
  say "Opening the docs in your Windows browser."
  say "If no browser window appears, paste this into your browser's address bar:"
  say "  $win_copy"
}

# docs_opener -> the command that opens a file in the browser on this
# machine: open (macOS), wslview (WSL, which maps Linux paths for Windows),
# else xdg-open. Prints nothing when none is installed.
docs_opener() {
  local c
  if [ "$(uname -s)" = Darwin ]; then c=open
  elif { [ -n "${WSL_DISTRO_NAME:-}" ] || is_wsl; } && command -v wslview >/dev/null 2>&1; then c=wslview
  else c=xdg-open; fi
  command -v "$c" >/dev/null 2>&1 && printf '%s' "$c"
  return 0
}

# --- update --------------------------------------------------------------------------
# pull_factory -> fast-forward this checkout to its upstream. When that brings
# new commits, re-runs `factory update` from the new code (the script on disk
# may have changed under this process).
pull_factory() {
  local before broker_change broker_pin_commit broker_head_commit
  step "Updating the factory code"
  if ! git -C "$ROOT" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    warn "this checkout has no upstream branch; skipping git pull"
    return 0
  fi
  # --ignore-submodules=all: broker/ only ever moves because pull_factory's own
  # "submodule update --init" below moves it to match the superproject's pin;
  # that pin-only difference must never look like an uncommitted change and
  # block every future pull (confirmed empirically: --ignore-submodules=dirty
  # does NOT hide it, since git still reports a submodule commit mismatch as
  # "modified" even with =dirty -- only "=all" does). A real uncommitted
  # change to a tracked file or an untracked file in $ROOT still shows and
  # still blocks.
  if [ -n "$(git "${BROKER_GIT_SAFE[@]}" -C "$ROOT" status --porcelain --ignore-submodules=all)" ]; then
    warn "$ROOT has uncommitted changes; skipping git pull (commit or stash them to pull)"
    return 0
  fi
  # broker/ is ignored above, so an edit or an unreviewed local commit there
  # (an agent working on this repo can write into broker/ like any other
  # file) would otherwise go unseen: "git submodule update --init" below
  # would silently detach a local commit. Being behind the pin is fine --
  # that's exactly what "submodule update --init" below fixes -- so only
  # refuse when broker/ is dirty, or has moved away from the pin's history
  # rather than just lagging behind it. Every check goes through broker_git
  # (lib/common.sh), which never trusts broker/.git and refuses a broker/.git
  # that doesn't point at the real module directory -- checked before the
  # pull and submodule update below, which do follow it. Git-ignored files
  # (e.g. a __pycache__/ from running the broker's tests) don't block: the
  # update leaves them alone, and the image build never uses the working
  # tree (it exports the pinned commit). A submodule with no trace of
  # initialization (a plain clone) has nothing to lose; the update below
  # initializes it.
  if broker_initialized "$ROOT"; then
    if ! broker_change="$(broker_dirty "$ROOT" 2>&1)"; then
      warn "skipping git pull: $broker_change"
      return 0
    fi
    broker_change="$(broker_blocking_changes "$broker_change")"
    if [ -n "$broker_change" ]; then
      warn "$ROOT/broker has uncommitted changes (including untracked files); skipping git pull (commit or stash them, then run 'factory update' again)"
      return 0
    fi
    broker_pin_commit="$(broker_pin "$ROOT")"
    broker_head_commit="$(broker_head "$ROOT")"
    if [ "$broker_head_commit" != "$broker_pin_commit" ] \
      && ! broker_git "$ROOT" merge-base --is-ancestor "$broker_head_commit" "$broker_pin_commit" 2>/dev/null; then
      warn "$ROOT/broker has a local commit ($broker_head_commit) that isn't part of the pinned history ($broker_pin_commit); skipping git pull (it would otherwise be silently detached - investigate it, then run 'factory update' again)"
      return 0
    fi
  fi
  before="$(git -C "$ROOT" rev-parse HEAD)"
  git "${BROKER_GIT_SAFE[@]}" -C "$ROOT" pull --ff-only --no-recurse-submodules --quiet \
    || die "git pull failed; sort it out in $ROOT, then run 'factory update' again"
  # Move broker/ to the (possibly new) pin. An initialized broker/ is moved
  # with broker_git rather than "git submodule update", which would follow
  # broker/.git -- and an agent could rewrite that between the check above
  # and this step, pointing it at a repository whose config runs commands.
  # Only a never-initialized submodule goes through "submodule update --init"
  # (BROKER_GIT_SAFE also reaches the git processes it runs inside broker/).
  if broker_initialized "$ROOT"; then
    broker_pin_commit="$(broker_pin "$ROOT")"
    if ! broker_git "$ROOT" cat-file -e "$broker_pin_commit^{commit}" 2>/dev/null; then
      broker_git "$ROOT" fetch --quiet origin \
        || die "fetching broker/ failed; sort it out in $ROOT, then run 'factory update' again"
    fi
    broker_git "$ROOT" checkout --quiet --detach "$broker_pin_commit" \
      || die "checking out the broker pin $broker_pin_commit failed; sort it out in $ROOT/broker, then run 'factory update' again"
  else
    git "${BROKER_GIT_SAFE[@]}" -C "$ROOT" submodule update --init --quiet \
      || die "git submodule update --init failed; sort it out in $ROOT, then run 'factory update' again"
  fi
  if [ "$(git -C "$ROOT" rev-parse HEAD)" = "$before" ]; then
    ok "already up to date"
    return 0
  fi
  ok "pulled:"
  git -C "$ROOT" log --oneline "$before..HEAD" | sed 's/^/      /'
  exec "$ROOT/bin/factory" update --pulled "$@"
}

# describe_loss SANDBOX -> what recreating it discards
describe_loss() {
  case "$1" in
    "$BROKER_SANDBOX")
      if sbx secret ls --sandbox "$BROKER_SANDBOX" 2>/dev/null | grep -qE '[[:space:]]github[[:space:]]'; then
        echo "its GitHub token (sbx deletes secrets scoped to a removed sandbox; re-add it afterwards with: sbx secret set github --sandbox $BROKER_SANDBOX)"
      else
        echo "nothing (it keeps no history)"
      fi ;;
    "$COORDINATOR_SANDBOX") echo "the Coordinator's conversation history" ;;
    *)
      if [ "$(role_get "${1#factory-}" WORKSPACE)" = rw ]; then
        echo "the saved sessions of its lanes (their next tasks start fresh) and its lane clones: anything not committed to a factory/* branch (committed branches are already in your project as factory-<lane>/... refs)"
      else
        echo "the role's saved sessions (its next tasks start fresh)"
      fi ;;
  esac
}

# forget_role_sessions ROLE -> delete the saved session of every lane of ROLE
# (sessions/<lane> and <lane>.json), including lanes beyond its current LANES.
forget_role_sessions() {
  local f lane
  for f in "$FACTORY_DISPATCH_STATE"/sessions/*; do
    [ -e "$f" ] || continue
    lane="${f##*/}"
    lane="${lane%.json}"
    if [ "$lane" = "$1" ] || printf '%s' "$lane" | grep -Eqx -- "$1-lane[0-9]+"; then
      rm -f "$f"
    fi
  done
}

# plan_maybe_sandboxes CHANGED-FILES -> "SANDBOX<TAB>WHY" lines: existing
# sandboxes whose inputs (image, kit, role) the incoming files touch. A
# heuristic: the update itself decides from fingerprints after it rebuilds.
plan_maybe_sandboxes() {
  local changed="$1" existing r t sb f why
  existing="$(sbx ls -q 2>/dev/null || true)"
  emit() { printf '%s\n' "$existing" | grep -qx "$1" && printf '%s\t%s\n' "$1" "$2"; return 0; }
  # One path per line, read as is: a name with spaces or glob characters is
  # neither split nor expanded.
  printf '%s\n' "$changed" | while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in
      broker|broker/*|kits/broker/*) emit "$BROKER_SANDBOX" "the broker's code or kit changes ($f)" ;;
      kits/coordinator/*) emit "$COORDINATOR_SANDBOX" "its kit changes ($f)" ;;
      templates/developer/*|templates/agent/*) emit "$COORDINATOR_SANDBOX" "its image changes ($f)" ;;
      scripts/lib/roles.sh) emit "$COORDINATOR_SANDBOX" "how sandboxes are fingerprinted changes ($f)"
        emit "$BROKER_SANDBOX" "how sandboxes are fingerprinted changes ($f)" ;;
    esac
    for r in $(list_roles); do
      sb="$(role_sandbox "$r")"
      t="$(role_get "$r" TEMPLATE)"
      why=""
      case "$f" in
        roles/"$r"/kit/*|roles/"$r"/role.conf) why="its role changes ($f)" ;;
        templates/"$t"/*|templates/agent/*) why="its image changes ($f)" ;;
        scripts/lib/roles.sh) why="how sandboxes are fingerprinted changes ($f)" ;;
      esac
      [ -z "$why" ] || emit "$sb" "$why"
    done
  done | awk -F'\t' '!seen[$1]++'
}

# cmd_update_plan -> what `factory update` would do, as tab-separated lines,
# changing nothing but the factory checkout's remote-tracking refs (a hook-free
# `git fetch`). The dashboard's UPDATE key shows it before asking to confirm:
#   commit<TAB>SHA<TAB>SUBJECT      each incoming commit (HEAD..@{u})
#   recreate<TAB>SANDBOX<TAB>LOSES  out of date now (stale_sandboxes): recreated
#   maybe<TAB>SANDBOX<TAB>WHY       may be recreated once the new code is built
#   note<TAB>TEXT                   anything that changes what update does
cmd_update_plan() {
  local upstream changed="" sb stale broker_change
  if ! upstream="$(git "${BROKER_GIT_SAFE[@]}" -C "$ROOT" rev-parse --abbrev-ref '@{u}' 2>/dev/null)"; then
    printf 'note\t%s\n' "this checkout has no upstream branch: update skips git pull and only rebuilds"
  else
    git "${BROKER_GIT_SAFE[@]}" -C "$ROOT" fetch --quiet --no-recurse-submodules 2>/dev/null \
      || printf 'note\t%s\n' "could not fetch $upstream: the commits below may be out of date"
    git "${BROKER_GIT_SAFE[@]}" -C "$ROOT" log --no-color --format='commit%x09%h%x09%s' 'HEAD..@{u}' 2>/dev/null || true
    if ! git "${BROKER_GIT_SAFE[@]}" -C "$ROOT" merge-base --is-ancestor HEAD '@{u}' 2>/dev/null; then
      printf 'note\t%s\n' "this checkout has commits that $upstream doesn't: git pull --ff-only will fail"
    fi
    changed="$(git "${BROKER_GIT_SAFE[@]}" -c core.quotePath=false -C "$ROOT" diff --no-ext-diff --no-textconv --name-only 'HEAD...@{u}' 2>/dev/null || true)"
    if [ -n "$(git "${BROKER_GIT_SAFE[@]}" -C "$ROOT" status --porcelain --ignore-submodules=all)" ]; then
      printf 'note\t%s\n' "$ROOT has uncommitted changes: update skips git pull (commit or stash them to pull)"
    elif broker_initialized "$ROOT"; then
      if ! broker_change="$(broker_dirty "$ROOT" 2>&1)"; then
        printf 'note\t%s\n' "update skips git pull: $broker_change"
      elif [ -n "$(broker_blocking_changes "$broker_change")" ]; then
        printf 'note\t%s\n' "$ROOT/broker has uncommitted changes: update skips git pull"
      fi
    fi
  fi
  stale="$(stale_sandboxes)"
  for sb in $stale; do printf 'recreate\t%s\t%s\n' "$sb" "$(describe_loss "$sb")"; done
  [ -z "$changed" ] || plan_maybe_sandboxes "$changed" | while IFS="$(printf '\t')" read -r sb why; do
    printf '%s\n' "$stale" | grep -qx "$sb" || printf 'maybe\t%s\t%s (a guess from the changed files)\n' "$sb" "$why"
  done
  if [ -z "$(bound_project)" ]; then
    printf 'note\t%s\n' "no project is bound: update rebuilds but starts nothing"
  fi
  return 0
}

cmd_update() {
  local yes="" pulled="" plan="" arg stale sb project
  for arg in "$@"; do
    case "$arg" in
      --yes|-y) yes=1 ;;
      --pulled) pulled=1 ;;
      --plan) plan=1 ;;
      *) die "usage: factory update [--yes | --plan]" ;;
    esac
  done
  if [ -n "$plan" ]; then
    [ -z "$yes$pulled" ] || die "usage: factory update [--yes | --plan]"
    cmd_update_plan
    return
  fi
  [ -n "$pulled" ] || pull_factory ${yes:+--yes}

  FACTORY_UPDATING=1 cmd_setup

  step "Checking which sandboxes the changes affect"
  stale="$(stale_sandboxes | tr '\n' ' ')"
  stale="${stale% }"
  if [ -z "$stale" ]; then
    ok "every sandbox is up to date"
  else
    say "  These were made from an older image or kit and will be recreated:"
    for sb in $stale; do say "    $B$sb$N: loses $(describe_loss "$sb")"; done
    say "  Your Claude login, settings, logs and the project itself are kept."
    [ -n "$yes" ] || confirm "Recreate them now?" \
      || die "cancelled; nothing was removed. Run 'factory update' again when you're ready."
  fi

  step "Restarting the factory"
  "$SCRIPTS/03-stop-factory.sh" >/dev/null
  ok "stopped the agents, broker and dispatch bridge"
  if [ -n "$stale" ]; then
    # shellcheck disable=SC2086 # one argument per sandbox
    sbx rm --force $stale >/dev/null
    for sb in $stale; do forget_role_sessions "${sb#factory-}"; done
    ok "removed $stale"
  fi
  project="$(bound_project)"
  if [ -n "$project" ] && [ -d "$project" ]; then
    # Never end an update in the foreground dashboard (layout "web"): scripts
    # run `factory update --yes` and expect it to return.
    cmd_start "$project" --no-dashboard
  else
    say ""
    say "${G}Updated.${N} Next: cd into a project and run ${B}factory start${N}"
  fi
}

# --- watch -----------------------------------------------------------------------------
