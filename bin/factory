#!/usr/bin/env bash
set -euo pipefail

# factory: one command for the AI code factory. Run `factory help`.

# Resolve the repo root through symlinks (factory setup links this into ~/.local/bin).
# Use BASH_SOURCE, not $0: $0 is this script's path when it is run directly,
# but the caller's when a test sources it to call a function like
# pull_factory without running main (see the guard at the bottom of this file).
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
SCRIPTS="$(cd -P "$(dirname "$src")/.." && pwd)/scripts"
# Always this repo's root, whatever ROOT the environment had: an exported ROOT
# must never redirect a real run (pull_factory even execs "$ROOT/bin/factory").
# A test that sources this file sets ROOT to a fixture checkout afterwards.
ROOT="$(dirname "$SCRIPTS")"

# shellcheck source=../scripts/lib/common.sh
. "$SCRIPTS/lib/common.sh"

# Commands already ported to the Python package (factory/, docs/py-cli-migration.md)
# run there; factory/cli.py's COMMANDS lists the same names (a test keeps them equal).
# Everything else falls through to the bash below until it is ported. Only when run
# directly: a test that sources this file still gets the bash functions.
PORTED_COMMANDS="analytics approvals approve chat config coordinator dashboard docs doctor down gui log logs packet packets reset restart role roles secret status stop watch"
if [ "${BASH_SOURCE[0]}" = "$0" ] && [ -n "${1:-}" ]; then
  case " $PORTED_COMMANDS " in
    *" $1 "*)
      py="$(resolve_python)"
      exec "$py" "$ROOT/factory" "$@" ;;
  esac
fi
# roles.sh dies without broker/tools.txt. 'factory help' needs neither, so it skips it:
# it must work on a fresh clone, before 'factory setup' (a test sourcing this file
# always gets roles.sh). 'setup' skips it too: it runs 'factory doctor' (Python, which
# checks broker/ itself and reports what it finds) first, and loads roles.sh after.
case "${BASH_SOURCE[0]}:${1:-help}" in
  "$0":help|"$0":-h|"$0":--help|"$0":setup) ;;
  *)
    # shellcheck source=../scripts/lib/roles.sh
    . "$SCRIPTS/lib/roles.sh" ;;
esac
# shellcheck source=../scripts/lib/preflight.sh
. "$SCRIPTS/lib/preflight.sh"
# shellcheck source=../scripts/lib/secrets.sh
. "$SCRIPTS/lib/secrets.sh"


if [ -t 1 ]; then B=$'\033[1m' G=$'\033[32m' Y=$'\033[33m' R=$'\033[31m' N=$'\033[0m'
else B="" G="" Y="" R="" N=""; fi

say() { printf '%s\n' "$*"; }
step() { printf '\n%s==> %s%s\n' "$B" "$*" "$N"; }
ok() { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; }
bad() { printf '  %s✗%s %s\n' "$R" "$N" "$*"; }

confirm() { # confirm QUESTION -> success on y/yes
  local answer
  [ -t 0 ] || return 1
  printf '%s [y/N] ' "$1"
  read -r answer
  case "$answer" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

bound_project() { cat "$FACTORY_BROKER_STATE/project" 2>/dev/null || true; }

usage() {
  cat <<EOF
${B}factory${N}: run a team of sandboxed Claude agents on a project.

${B}Usage${N}
  factory doctor             Check this machine is ready, and say how to fix what isn't
  factory setup              One-time setup: install tools, sign in, build images,
                             apply the security baseline, put 'factory' on your PATH
  factory update [--yes]     Pull the latest factory, rebuild, recreate whatever
                             sandboxes the changes need, and restart
  factory update --plan      Say what 'factory update' would do, changing nothing
                             (but a git fetch): incoming commits, sandboxes it
                             recreates and what each loses
  factory start [dir] [--no-ui]
                             Start the factory for a project (default: this folder)
                             and open the dashboard in your browser, with the
                             Coordinator's terminal in it; --no-ui opens nothing
                             and prints how to reach the Coordinator and follow
                             the roles. (--layout web is accepted and ignored;
                             the old "watch" and "tabs" layouts fall back to it.)
  factory chat               Talk to the Coordinator in this terminal
  factory status             What is running, and for which project
  factory stop               Stop the agents, broker and dispatch bridge
  factory restart            Stop, then start the factory again for its project
                             (the dashboard, if open, keeps running)
  factory logs [name]        Follow a role's work (all its lanes; e.g. developer,
                             or one lane: developer-lane2), or broker / dispatch
  factory watch              Live view of the lanes: a pane per active lane, idle lanes as
                             one line each, tool calls condensed, status and cost in titles
  factory dashboard [--no-open] [--port N] [--demo]
                             The whole factory on one screen in your browser: the
                             Coordinator's terminal, lanes, spend, broker calls,
                             held writes (local). Its control unit approves and
                             declines held writes and runs restart and update
                             (each after a confirm step). Prints a link with this
                             run's token; 'gui' also works. --demo shows made-up
                             data with no factory running (display only)
  factory packet [id|lane]   A job's review packet: task, branch commits and diffstat,
                             tests, broker calls, cost, report (default: the latest;
                             --list for recent jobs)
  factory roles              List roles and what they may do
  factory role new <name> [like]
                             Add a role, copied from an existing one (default: reviewer)
  factory config init [--force]
                             Write the commented example settings into
                             $FACTORY_CONFIG; refuses to overwrite files unless --force
  factory secret save <name> Store a credential once in this machine's keychain
                             (github, gitlab, jira, gemini, npm-registry,
                             approvals-webhook); every broker start
                             then delivers it
  factory secret forget <name>
                             Delete it from the keychain and from the running broker
  factory secret set <name>  Deliver a broker credential to the running broker only
                             (until it is recreated), for machines with no keychain
  factory secret rm <name>   Remove a credential delivered with 'factory secret set'
  factory secret ls          List credentials managed by 'factory secret set'
  factory docs [--print]     Open these docs, with guides, in your browser (offline);
                             --print writes the HTML to stdout instead
  factory analytics          Cost, token and performance report from the audit logs
  factory approvals          Pushes and PRs the gateway is holding for you:
                             list, show <id>, approve <id>, decline <id> --reason ..., watch
  factory reset              Remove the agent sandboxes to switch projects
                             (your Claude login is kept)

${B}Examples${N}
  factory docs
  cd ~/code/my-app && factory start
  factory logs developer
  factory role new designer reviewer
  factory analytics --json | jq '.roles'
EOF
}

# --- setup -------------------------------------------------------------------------
cmd_setup() {
  "$(resolve_python)" "$ROOT/factory" doctor || die "fix the problems above, then run 'factory setup' again"
  # doctor passed, so broker/ is usable; roles.sh (needed by onboarding_hints) was skipped up front
  # shellcheck source=../scripts/lib/roles.sh
  . "$SCRIPTS/lib/roles.sh"

  step "Installing pinned tools (sbx $SBX_VERSION)"
  "$SCRIPTS/install-prereqs.sh"
  export PATH="$HOME/.local/bin:$PATH"

  if sbx_not_signed_in; then
    step "Signing in to Docker (sbx)"
    say "Not signed in yet; a browser window opens:"
    sbx login || die "sbx login failed: run 'sbx login' yourself, then 'factory setup' again"
  fi

  step "Building sandbox images"
  local log
  log="$(mktemp)"
  if ! "$SCRIPTS/00-build-templates.sh" 2>&1 | tee "$log" | grep -E '^Building' | sed 's/^/  /'; then
    if grep -q "Not authenticated" "$log"; then
      say "Sign in to Docker to continue (a browser window opens):"
      sbx login
      "$SCRIPTS/00-build-templates.sh" 2>&1 | grep -E '^Building|rror' | sed 's/^/  /'
    else
      tail -20 "$log"
      rm -f "$log"
      die "image build failed"
    fi
  fi
  rm -f "$log"

  step "Applying the security baseline"
  "$SCRIPTS/01-init-security.sh" >/dev/null
  ok "outbound network blocked by default; Anthropic API allowed; local MCP gateway on"

  step "Adding 'factory' to your PATH"
  mkdir -p "$HOME/.local/bin"
  ln -sf "$ROOT/bin/factory" "$HOME/.local/bin/factory"
  ok "linked ~/.local/bin/factory"
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) warn "add this to your shell profile: export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
  esac

  onboarding_hints

  say ""
  say "${G}Setup complete.${N} Next: cd into a project and run ${B}factory start${N}"
}

setup_done() {
  [ "$(sbx settings get mcp.forceLocalGateway 2>/dev/null)" = "true" ] || return 1
  local templates
  templates="$(sbx template ls -q 2>/dev/null)"
  # The tag matters: after a TEMPLATE_TAG bump the old images are still listed,
  # but the sandboxes are created from factory-<image>:$TEMPLATE_TAG.
  for image in developer reviewer broker; do
    printf '%s\n' "$templates" | grep -Eq "factory-$image:$TEMPLATE_TAG([[:space:]]|\$)" || return 1
  done
}

# --- start -------------------------------------------------------------------------
# require_project_commits PROJECT -> die, naming the repo, if any repository
# the roles would work in (project_repos) has no commits: the lane clone and
# the review packet both need a HEAD, and would fail much later without one.
require_project_commits() {
  local project="$1" repo dir
  for repo in $(project_repos "$project"); do
    dir="$project/$repo"
    git "${BROKER_GIT_SAFE[@]}" -C "$dir" rev-parse --verify --quiet 'HEAD^{commit}' >/dev/null 2>&1 \
      || die "$dir is a git repository with no commits yet, so the developer has nothing to branch from. Make the first commit there (git -C '$dir' commit --allow-empty -m 'Initial commit'), then run 'factory start' again."
  done
}

cmd_start() {
  # --no-ui (or FACTORY_NO_UI=1): everything but the dashboard. Talk to the
  # Coordinator with `factory chat` and follow roles with `factory watch` or
  # `factory logs`. Otherwise the start ends by running `factory dashboard`,
  # which holds the Coordinator's terminal.
  # --layout (or FACTORY_LAYOUT) is kept only so old habits and saved choices
  # don't break: "web" is the one layout, and resolve_layout warns about the
  # removed "watch" and "tabs".
  # --no-dashboard (internal, from cmd_update and `factory restart`, which is
  # Python): finish instead of running the dashboard in the foreground, so
  # `factory update --yes` and `factory restart` return.
  local target="" project current no_ui="${FACTORY_NO_UI:-}" layout_flag="" no_dashboard=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-ui) no_ui=1 ;;
      --no-dashboard) no_dashboard=1 ;;
      --layout)
        [ $# -ge 2 ] || die "usage: factory start [dir] [--no-ui] [--layout web]"
        layout_flag="$2"
        shift ;;
      -*) die "usage: factory start [dir] [--no-ui] [--layout web]" ;;
      *) [ -z "$target" ] || die "usage: factory start [dir] [--no-ui] [--layout web]"; target="$1" ;;
    esac
    shift
  done
  resolve_layout "$layout_flag" "${FACTORY_LAYOUT:-}" >/dev/null
  target="${target:-.}"
  [ -d "$target" ] || die "no such directory: $target"
  project="$(cd "$target" && pwd -P)"
  require_sbx
  setup_done || die "the factory is not set up yet: run 'factory setup' first"
  require_project_commits "$project"
  case "$project" in
    /mnt/[a-z]/*) is_wsl && warn "$project is on a Windows drive: sandboxes will be slow and file permissions unreliable. Clone it into the Linux filesystem (e.g. ~/code) instead." ;;
  esac

  current="$(bound_project)"
  if [ -n "$current" ] && [ "$current" != "$project" ] && sbx ls -q | grep -q '^factory-'; then
    say "The factory is currently set up for ${B}$current${N}."
    if confirm "Switch to $project? This removes the agent sandboxes (your Claude login is kept)."; then
      "$(resolve_python)" "$ROOT/factory" reset --yes
    else
      die "not switching. Run 'factory start $current' to open the current project."
    fi
  fi

  if [ "$no_ui" = 1 ]; then
    FACTORY_NO_UI=1 "$SCRIPTS/02-launch-factory.sh" "$project"
    onboarding_hints
    say ""
    say "Factory running, without the dashboard."
    say "  Talk to the Coordinator:  ${B}factory chat${N}"
    say "  Watch every lane:         ${B}factory watch${N}"
    say "  Follow one role's log:    ${B}factory logs <role>${N}  (roles: $(list_roles | tr '\n' ' '))"
    say "  Stop everything:          ${B}factory stop${N}"
  else
    "$SCRIPTS/02-launch-factory.sh" "$project"
    onboarding_hints
    say ""
    if [ -n "$no_dashboard" ]; then
      say "Factory running. Run ${B}factory dashboard${N} to open it."
      return
    fi
    say "Factory running. Opening the dashboard: talk to the Coordinator on its screen."
    say "Ctrl-C closes the dashboard (and the Coordinator's terminal); the factory keeps"
    say "running. Reopen it with ${B}factory dashboard${N}; stop everything with ${B}factory stop${N}."
    "$(resolve_python)" "$ROOT/factory" dashboard
  fi
}

# jira_cloud_id_set -> success if [jira].cloud_id is set to something other
# than empty or the all-zero placeholder UUID from config.example/.
jira_cloud_id_set() {
  local id
  id="$(policy_string jira cloud_id)"
  [ -n "$id" ] && [ -n "${id//[0-]/}" ]
}

git_push_enabled() {
  policy_value git repos | grep -qE '\[.*[^][:space:]].*\]'
}

# github_repos_listed -> success if some [git].repos entry is a GitHub owner/name
# (its first segment has no dot or port; a host-qualified entry is on GitLab).
github_repos_listed() {
  policy_value git repos | grep -o '"[^"]*"' | tr -d '"' \
    | awk -F/ 'NF >= 2 && $1 !~ /[.:]/ { f = 1 } END { exit !f }'
}

# keychain_has SERVICE: scripts/lib/secrets.sh (macOS Keychain, Linux
# secret-tool, or the Windows Credential Manager on WSL2).

# keychain_warn_missing SERVICE MESSAGE -> warn MESSAGE if the keychain has
# no SERVICE; if it is locked or unavailable (keychain_has status 2), say
# that instead, since whether SERVICE is stored can't be told.
keychain_warn_missing() {
  local rc=0
  keychain_has "$1" || rc=$?
  case "$rc" in
    0) ;;
    1) warn "$2" ;;
    *) warn "the keychain is locked or unavailable, so $1 couldn't be checked; unlock it and run this again" ;;
  esac
}

# any_jira_tool_granted -> success if the Coordinator or any role is granted a
# jira_* broker tool (jira_my_issues, jira_get_issue). Other broker tools
# (web_fetch, npm_fetch, ...) don't need a Jira token, so warning on any
# BROKER_TOOLS grant would be a false positive for roles/setups that never
# touch Jira.
any_jira_tool_granted() {
  local r
  case " $(coordinator_broker_tools) " in *" jira_"*) return 0 ;; esac
  for r in $(list_roles); do
    case " $(role_get "$r" BROKER_TOOLS) " in *" jira_"*) return 0 ;; esac
  done
  return 1
}

# gitlab_needs_token -> success if the policy sets [gitlab].url: the git tools
# and gitlab_create_mr then need the gitlab credential (a file, as sbx can't
# inject it).
gitlab_needs_token() {
  # Either TOML string form ("..." or '...'), as long as it isn't empty.
  policy_value gitlab url | grep -qE "^[[:space:]]*(\"[^\"]+\"|'[^']+')"
}

# gitlab_mr_unheld -> prints why, and succeeds, when GitLab merge requests would
# open without approval although other writes are held: gitlab_create_mr is
# granted and [gitlab].url set, but the local [approvals].tools list leaves it
# out. Silent otherwise: no list or tools = [] means holds are off altogether
# (the gateway holds nothing until the list names a tool).
gitlab_mr_unheld() {
  local r granted="" tools
  for r in $(list_roles); do
    case " $(role_get "$r" BROKER_TOOLS) " in *" gitlab_create_mr "*) granted=1 ;; esac
  done
  [ -n "$granted" ] && gitlab_needs_token || return 1
  tools="$(policy_value approvals tools || true)"
  [ -n "$tools" ] || return 1  # no list: holds are off
  case "$tools" in *'"gitlab_create_mr"'*) return 1 ;; esac
  [ -n "$(printf '%s' "$tools" | tr -d '[] \t')" ] || return 1  # tools = []: nothing is held at all
  printf '%s\n' "[approvals].tools is set without \"gitlab_create_mr\""
}

# npm_private_registry_needs_token -> success if a role is granted npm_fetch and
# the policy names a private npm registry (which needs the keychain credential).
npm_private_registry_needs_token() {
  local r granted=""
  for r in $(list_roles); do
    case " $(role_get "$r" BROKER_TOOLS) " in *" npm_fetch "*) granted=1 ;; esac
  done
  [ -n "$granted" ] || return 1
  [ -n "$(policy_string packages npm_private_registry)" ]
}

onboarding_hints() {
  local stale
  if [ -z "${FACTORY_UPDATING:-}" ]; then
    stale="$(stale_sandboxes | tr '\n' ' ')"
    [ -z "$stale" ] || warn "out of date (made from an older image or kit): ${stale% }; run 'factory update' to recreate them"
  fi
  if ! claude_login_stored; then
    warn "first time: type /login in the Coordinator (POWER ON on the dashboard) to sign in with your Claude subscription, then run 'factory start' again (or press RESTART on the dashboard) to create the role sandboxes"
  fi
  if git_push_enabled; then
    local sbx_secrets
    sbx_secrets="$(sbx secret ls 2>/dev/null || true)"
    if printf '%s\n' "$sbx_secrets" | awk '$1 == "(global)" && $3 == "github" { f = 1 } END { exit !f }'; then
      warn "a global GitHub token is stored, so sbx injects it for every sandbox, not just the broker. Run 'factory secret save github', then remove the global one: sbx secret rm github"
    elif github_repos_listed && ! printf '%s\n' "$sbx_secrets" | grep -q " github "; then
      warn "git push/PR is enabled but no GitHub token is stored: run 'factory secret save github' (see README: Enabling git push and pull requests)"
    fi
  fi
  if any_jira_tool_granted; then
    keychain_warn_missing factory-jira "Jira tools are granted but no token is stored in the keychain (see README: Enabling Jira)"
    jira_cloud_id_set || warn "Jira tools are granted but [jira].cloud_id is not set; set it in $FACTORY_CONFIG/policy.toml (see README: Enabling Jira)"
  fi
  if npm_private_registry_needs_token; then
    keychain_warn_missing factory-npm-registry "npm_fetch can't download private npm packages until a token is stored in the keychain (see README: Enabling a private npm registry)"
  fi
  if gitlab_needs_token; then
    keychain_warn_missing factory-gitlab "[gitlab].url is set but no GitLab token is stored: run 'factory secret save gitlab' (see README: Enabling GitLab)"
  fi
  local why
  if why="$(gitlab_mr_unheld)"; then
    warn "GitLab merge requests open without approval: $why (see README: Enabling approvals)"
  fi
}

# --- stop / reset: ported to Python (factory/commands/runstate.py) ------------------
# rm_failed_after_stop (the Python copy is runstate.rm_failed_after_stop; a test compares them)
# COMMAND SANDBOXES RETRY -> `sbx rm` failed after COMMAND
# had already stopped the factory: say what is left stopped and how to recover,
# then exit. The project stays bound, so `factory start` brings it back.
rm_failed_after_stop() {
  local command="$1" sandboxes="$2" retry="$3"
  # shellcheck disable=SC2086 # one argument per sandbox
  bad "factory $command: could not remove $(printf '%s ' $sandboxes)"
  say "  Left stopped: the agent sandboxes, the broker and the dispatch bridge. Nothing was restarted."
  say "  Some of those sandboxes may already be gone ('sbx ls' shows what is left)."
  say "  To bring the factory back up: ${B}factory start${N} (in your project)."
  say "  To retry the removal: ${B}$retry${N}."
  exit 1
}

# --- update --------------------------------------------------------------------------
# pull_factory -> fast-forward this checkout to its upstream. When that brings
# new commits, re-runs `factory update` from the new code (the script on disk
# may have changed under this process).
pull_factory() {
  local before
  step "Updating the factory code"
  if ! git -C "$ROOT" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    warn "this checkout has no upstream branch; skipping git pull"
    return 0
  fi
  # broker/ is part of this checkout, so an edit or an untracked file there
  # blocks the pull like anywhere else. Git-ignored files (e.g. a __pycache__/
  # from running the broker's tests) don't show here and don't block: the
  # image build never uses the working tree (it exports the committed broker/).
  if [ -n "$(git "${BROKER_GIT_SAFE[@]}" -C "$ROOT" status --porcelain)" ]; then
    warn "$ROOT has uncommitted changes; skipping git pull (commit or stash them to pull)"
    return 0
  fi
  before="$(git -C "$ROOT" rev-parse HEAD)"
  git "${BROKER_GIT_SAFE[@]}" -C "$ROOT" pull --ff-only --quiet \
    || die "git pull failed; sort it out in $ROOT, then run 'factory update' again"
  if [ "$(git -C "$ROOT" rev-parse HEAD)" = "$before" ]; then
    ok "already up to date"
    return 0
  fi
  ok "pulled:"
  git -C "$ROOT" log --oneline "$before..HEAD" | sed 's/^/      /'
  exec "$ROOT/bin/factory" update --pulled "$@"
}

# describe_loss SANDBOX -> what recreating it discards
describe_loss() {
  case "$1" in
    "$BROKER_SANDBOX")
      if sbx secret ls --sandbox "$BROKER_SANDBOX" 2>/dev/null | grep -qE '[[:space:]]github[[:space:]]'; then
        echo "its GitHub token (sbx deletes secrets scoped to a removed sandbox; re-add it afterwards with: sbx secret set github --sandbox $BROKER_SANDBOX)"
      else
        echo "nothing (it keeps no history)"
      fi ;;
    "$COORDINATOR_SANDBOX") echo "the Coordinator's conversation history (the Coordinator is read-only, so a plan that exists only in that conversation is gone; ask a developer job to commit anything worth keeping first)" ;;
    *)
      if [ "$(role_get "${1#factory-}" WORKSPACE)" = rw ]; then
        echo "the saved sessions of its lanes (they live on the sandbox's own disk, so the next tasks start fresh) and its lane clones: anything not committed to a factory/* branch (committed branches are already in your project as factory-<lane>/... refs)"
      else
        echo "the role's saved sessions (they live on the sandbox's own disk, so its next tasks start fresh)"
      fi ;;
  esac
}

# forget_role_sessions ROLE -> delete the saved session of every lane of ROLE
# (sessions/<lane> and <lane>.json), including lanes beyond its current LANES.
forget_role_sessions() {
  local f lane
  for f in "$FACTORY_DISPATCH_STATE"/sessions/*; do
    [ -e "$f" ] || continue
    lane="${f##*/}"
    lane="${lane%.json}"
    if [ "$lane" = "$1" ] || printf '%s' "$lane" | grep -Eqx -- "$1-lane[0-9]+"; then
      rm -f "$f"
    fi
  done
}

# plan_maybe_sandboxes CHANGED-FILES -> "SANDBOX<TAB>WHY" lines: existing
# sandboxes whose inputs (image, kit, role) the incoming files touch. A
# heuristic: the update itself decides from fingerprints after it rebuilds.
plan_maybe_sandboxes() {
  local changed="$1" existing r t sb f why
  existing="$(sbx ls -q 2>/dev/null || true)"
  emit() { printf '%s\n' "$existing" | grep -qx "$1" && printf '%s\t%s\n' "$1" "$2"; return 0; }
  # One path per line, read as is: a name with spaces or glob characters is
  # neither split nor expanded.
  printf '%s\n' "$changed" | while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in
      broker/*|kits/broker/*) emit "$BROKER_SANDBOX" "the broker's code or kit changes ($f)" ;;
      kits/coordinator/*) emit "$COORDINATOR_SANDBOX" "its kit changes ($f)" ;;
      templates/developer/*|templates/agent/*) emit "$COORDINATOR_SANDBOX" "its image changes ($f)" ;;
      scripts/lib/roles.sh) emit "$COORDINATOR_SANDBOX" "how sandboxes are fingerprinted changes ($f)"
        emit "$BROKER_SANDBOX" "how sandboxes are fingerprinted changes ($f)" ;;
    esac
    for r in $(list_roles); do
      sb="$(role_sandbox "$r")"
      t="$(role_get "$r" TEMPLATE)"
      why=""
      case "$f" in
        roles/"$r"/kit/*|roles/"$r"/role.conf) why="its role changes ($f)" ;;
        templates/"$t"/*|templates/agent/*) why="its image changes ($f)" ;;
        scripts/lib/roles.sh) why="how sandboxes are fingerprinted changes ($f)" ;;
      esac
      [ -z "$why" ] || emit "$sb" "$why"
    done
  done | awk -F'\t' '!seen[$1]++'
}

# cmd_update_plan -> what `factory update` would do, as tab-separated lines,
# changing nothing but the factory checkout's remote-tracking refs (a hook-free
# `git fetch`). The dashboard's UPDATE key shows it before asking to confirm:
#   commit<TAB>SHA<TAB>SUBJECT      each incoming commit (HEAD..@{u})
#   recreate<TAB>SANDBOX<TAB>LOSES  out of date now (stale_sandboxes): recreated
#   maybe<TAB>SANDBOX<TAB>WHY       may be recreated once the new code is built
#   note<TAB>TEXT                   anything that changes what update does, and
#                                   what every update drops or keeps
cmd_update_plan() {
  local upstream changed="" sb stale
  if ! upstream="$(git "${BROKER_GIT_SAFE[@]}" -C "$ROOT" rev-parse --abbrev-ref '@{u}' 2>/dev/null)"; then
    printf 'note\t%s\n' "this checkout has no upstream branch: update skips git pull and only rebuilds"
  else
    git "${BROKER_GIT_SAFE[@]}" -C "$ROOT" fetch --quiet 2>/dev/null \
      || printf 'note\t%s\n' "could not fetch $upstream: the commits below may be out of date"
    git "${BROKER_GIT_SAFE[@]}" -C "$ROOT" log --no-color --format='commit%x09%h%x09%s' 'HEAD..@{u}' 2>/dev/null || true
    if ! git "${BROKER_GIT_SAFE[@]}" -C "$ROOT" merge-base --is-ancestor HEAD '@{u}' 2>/dev/null; then
      printf 'note\t%s\n' "this checkout has commits that $upstream doesn't: git pull --ff-only will fail"
    fi
    changed="$(git "${BROKER_GIT_SAFE[@]}" -c core.quotePath=false -C "$ROOT" diff --no-ext-diff --no-textconv --name-only 'HEAD...@{u}' 2>/dev/null || true)"
    if [ -n "$(git "${BROKER_GIT_SAFE[@]}" -C "$ROOT" status --porcelain)" ]; then
      printf 'note\t%s\n' "$ROOT has uncommitted changes: update skips git pull (commit or stash them to pull)"
    fi
  fi
  # What every update drops, whichever sandboxes it recreates; the per-sandbox
  # losses are the recreate lines. Keep in step with docs/guides/05-troubleshooting.md
  # ("What survives an update or a disconnect").
  printf 'note\t%s\n' "every update stops the dispatch bridge and all agent sandboxes: running jobs end (they show as interrupted afterwards; the job list, transcripts and review packets are kept) and held writes are dropped (queued writes, branches already in your project, saved sessions of sandboxes that aren't recreated, your Claude login and settings are kept)"
  stale="$(stale_sandboxes)"
  for sb in $stale; do printf 'recreate\t%s\t%s\n' "$sb" "$(describe_loss "$sb")"; done
  [ -z "$changed" ] || plan_maybe_sandboxes "$changed" | while IFS="$(printf '\t')" read -r sb why; do
    printf '%s\n' "$stale" | grep -qx "$sb" || printf 'maybe\t%s\t%s (a guess from the changed files)\n' "$sb" "$why"
  done
  if [ -z "$(bound_project)" ]; then
    printf 'note\t%s\n' "no project is bound: update rebuilds but starts nothing"
  fi
  return 0
}

cmd_update() {
  local yes="" pulled="" plan="" arg stale sb project
  for arg in "$@"; do
    case "$arg" in
      --yes|-y) yes=1 ;;
      --pulled) pulled=1 ;;
      --plan) plan=1 ;;
      *) die "usage: factory update [--yes | --plan]" ;;
    esac
  done
  if [ -n "$plan" ]; then
    [ -z "$yes$pulled" ] || die "usage: factory update [--yes | --plan]"
    cmd_update_plan
    return
  fi
  [ -n "$pulled" ] || pull_factory ${yes:+--yes}

  FACTORY_UPDATING=1 cmd_setup

  step "Checking which sandboxes the changes affect"
  stale="$(stale_sandboxes | tr '\n' ' ')"
  stale="${stale% }"
  if [ -z "$stale" ]; then
    ok "every sandbox is up to date"
  else
    say "  These were made from an older image or kit and will be recreated:"
    for sb in $stale; do say "    $B$sb$N: loses $(describe_loss "$sb")"; done
    say "  Your Claude login, settings, logs and the project itself are kept."
    [ -n "$yes" ] || confirm "Recreate them now?" \
      || die "cancelled; nothing was removed. Run 'factory update' again when you're ready."
  fi

  step "Restarting the factory"
  "$SCRIPTS/03-stop-factory.sh" >/dev/null
  ok "stopped the agents, broker and dispatch bridge"
  if [ -n "$stale" ]; then
    # shellcheck disable=SC2086 # one argument per sandbox
    sbx rm --force $stale >/dev/null \
      || rm_failed_after_stop "update" "$stale" "factory update"
    for sb in $stale; do forget_role_sessions "${sb#factory-}"; done
    ok "removed $stale"
  fi
  project="$(bound_project)"
  if [ -n "$project" ] && [ -d "$project" ]; then
    # Never end an update in the foreground dashboard: scripts
    # run `factory update --yes` and expect it to return.
    cmd_start "$project" --no-dashboard
  else
    say ""
    say "${G}Updated.${N} Next: cd into a project and run ${B}factory start${N}"
  fi
}

# --- main ----------------------------------------------------------------------------
# Guarded so a test can source this file (to call e.g. pull_factory directly)
# without running main: BASH_SOURCE[0] equals $0 only when run directly.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  command="${1:-help}"
  [ $# -eq 0 ] || shift
  case "$command" in
    setup) cmd_setup "$@" ;;
    update|upgrade) cmd_update "$@" ;;
    start|up) cmd_start "$@" ;;
    help|-h|--help) usage ;;
    *) usage; die "unknown command: $command" ;;
  esac
fi
