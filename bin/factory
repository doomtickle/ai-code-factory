# plain files under the broker state dir, host Python, nothing else.
cmd_approvals() {
  local python
  python="$(resolve_python)"
  "$python" "$SCRIPTS/approvals.py" --state "$FACTORY_BROKER_STATE" "$@"
}

# --- config ------------------------------------------------------------------------
# cmd_config init [--force] -> copies config.example/ into FACTORY_CONFIG. Every
# placeholder in the example is commented out, so the copy is inert. Writes
# nothing at all if any target file exists, unless --force.
cmd_config() {
  local sub="${1:-}" force="" arg src rel dest
  local -a files=() existing=()
  [ $# -eq 0 ] || shift
  [ "$sub" = init ] || die "usage: factory config init [--force]"
  for arg in "$@"; do
    case "$arg" in
      --force) force=1 ;;
      *) die "usage: factory config init [--force]" ;;
    esac
  done
  [ -d "$ROOT/config.example" ] || die "no config.example/ in $ROOT"
  while IFS= read -r src; do
    files+=("${src#"$ROOT/config.example/"}")
  done < <(find "$ROOT/config.example" -type f | LC_ALL=C sort)
  [ "${#files[@]}" -gt 0 ] || die "config.example/ in $ROOT is empty"
  # -L too: a dangling symlink is "absent" to -e, and cp would write through it.
  for rel in "${files[@]}"; do
    if [ -e "$FACTORY_CONFIG/$rel" ] || [ -L "$FACTORY_CONFIG/$rel" ]; then
      existing+=("$FACTORY_CONFIG/$rel")
    fi
  done
  if [ "${#existing[@]}" -gt 0 ] && [ -z "$force" ]; then
    for dest in "${existing[@]}"; do bad "exists: $dest"; done
    die "nothing written; re-run with --force to overwrite the files above"
  fi
  step "Config init ($FACTORY_CONFIG)"
  for rel in "${files[@]}"; do
    dest="$FACTORY_CONFIG/$rel"
    mkdir -p "$(dirname "$dest")"
    # --force replaces a symlink itself; cp would write through it to its target.
    [ ! -L "$dest" ] || rm -f "$dest"
    cp "$ROOT/config.example/$rel" "$dest"
    ok "wrote $dest"
  done
  say "Every value in them is commented out: uncomment and fill in only what you need."
  say "Next: factory doctor"
}

# --- main ----------------------------------------------------------------------------
# Guarded so a test can source this file (to call e.g. pull_factory directly)
# without running main: BASH_SOURCE[0] equals $0 only when run directly.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  command="${1:-help}"
  [ $# -eq 0 ] || shift
  case "$command" in
    doctor) cmd_doctor "$@" ;;
    setup) cmd_setup "$@" ;;
    update|upgrade) cmd_update "$@" ;;
    start|up) cmd_start "$@" ;;
    chat|coordinator) cmd_chat "$@" ;;
    status) cmd_status "$@" ;;
    stop|down) cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    reset) cmd_reset "$@" ;;
    logs|log) cmd_logs "$@" ;;
    packet|packets) cmd_packet "$@" ;;
    watch) cmd_watch "$@" ;;
    dashboard|gui) cmd_dashboard "$@" ;;
    roles) cmd_roles "$@" ;;
    role) cmd_role "$@" ;;
    config) cmd_config "$@" ;;
    secret) cmd_secret "$@" ;;
    analytics) cmd_analytics "$@" ;;
    docs) cmd_docs "$@" ;;
    approvals|approve) cmd_approvals "$@" ;;
    help|-h|--help) usage ;;
    *) usage; die "unknown command: $command" ;;
  esac
fi
